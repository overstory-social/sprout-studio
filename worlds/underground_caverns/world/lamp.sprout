// The brass lantern: a light source, which lights whatever dark room it is
// in, lying on the floor or carried. It also tells its bearer when it is
// lit, put out, picked up or set down, and a lamp on the floor tells the
// room, for the grue's sake: see the dark room, in room.sprout.
import * as sprout from 'sprout'
import {Portable, Thing} from 'thing'
import {Adventurer} from 'adventurer'
import {DarkRoom, Room} from 'room'
import {lamp_on, lamp_off, :light, :relight} from 'verbs'

kind Lamp is Portable, sprout.LightSource {
  without as target for lamp_on from Thing
  without as target for lamp_off from Thing

  // Examined, the lamp says what it is, then Zork's line for whether it is lit.
  describe {
    if (self.get(:lit)) { text lit_view }
    else { text dark_view }
  }
  passage view default { It is a battery-powered brass lantern, dented here and there but sound, with a stout handle and a glass that someone has kept clean. }
  passage lit_view {
    {self.view}

    The lamp is on.
  }
  passage dark_view {
    {self.view}

    The lamp is turned off.
  }

  as target for lamp_on {
    permit { if (self.get(:lit)) { refuse "It is already on." } }
    do {
      // Zork's V-LAMP-ON looks around if the light is new to the room.
      let was_dark = here.is(DarkRoom) && !here.get(:alight)
      self.set(:lit, true)
      say "The {self.short} is now on."
      if (actor.holds(self)) { send actor :light with 1 } else { send here :relight }
      if (was_dark && here.is(Room)) { say "{here.full}" }
    }
  }

  as target for lamp_off {
    permit { if (!self.get(:lit)) { refuse "It is already off." } }
    do {
      self.set(:lit, false)
      say "The {self.short} is now off."
      if (actor.holds(self)) { send actor :light with -1 } else { send here :relight }
      if (here.is(DarkRoom)) { say "It is now pitch black." }
    }
  }

  on :moved (from, to) {
    if (self.get(:lit)) {
      if (from.is(Adventurer)) { send from :light with -1 }
      if (to.is(Adventurer)) { send to :light with 1 }
    }
  }
}
