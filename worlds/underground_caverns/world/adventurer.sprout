// The adventurer: what every visitor is made of. Zork's own parts of the
// verbs that are the adventurer's to answer (taking, dropping, putting,
// fighting, the score), the light they carry, their wounds, their score and
// their deaths.
//
// Dying is Zork's JIGS-UP: ten points lost, then, the first two times, the
// Forest with what was carried scattered (the lamp to the Living Room,
// treasures to dark places, everything else above ground); the third time,
// the Land of the Living Dead. Getting there takes the world's gate, since
// no room can otherwise reach another.
import * as sprout from 'sprout'
import {Thing, Portable} from 'thing'
import {Box} from 'box'
import {Lamp} from 'lamp'
import {Weapon, Sword, Knife, Axe, Treasure, Food, Water} from 'items'
import {Room, DarkRoom, Forest, Perilous} from 'room'
import {TreeTop, Nest, Egg} from 'tree'
import {Troll} from 'troll'
import {go, look, examine, inventory, wait} from 'sprout'
import {take, drop, put, give, knock, dig, dig_here, walk_around, walk_about, through, attack, open, close, read, look_in, look_under, lamp_on, lamp_off, shift, raise, eat, drink, wind, tally, smell, listen, climb_up, climb_down, unlock, lock, score, diagnose, xyzzy, hello, jump, yell, zork, verbose, brief, superbrief, quit, restart, save, restore, curse, Dest, Mode, :scored, :light, :relight, :room_lit, :grue, :open_gate, :gate_open, :close_gate, :blow, :struck, :troll_gone, :glow, :die, :claimed, :settle, :travel} from 'verbs'
import {behind_house, clearing, forest_1, forest_2, forest_3, forest_path, grating_clearing, north_of_house, south_of_house, west_of_house} from 'above_ground'
import {cellar, troll_room} from 'cellar'
import {attic, kitchen, living_room} from 'house'
import {land_of_the_living_dead} from 'nowhere'

kind Adventurer is sprout.Visitor {
  :capacity 30
  :score 0 min -100 max 350
  :deaths 0 min 0 max 3
  :light 0 min 0 max 9
  :room_dark false
  :wounds 0 min 0 max 9
  :fight 2 min -9 max 9
  :staggered false
  :healing false
  :load 0 min 0 max 900
  :dest Dest default forest_1
  :devoured false
  :own_light false
  :mode Mode default brief
  // Zork's MOVES: every command but the ones about the game itself.
  :moves 0 min 0 max 1000000
  // Scratch for taking several things in one command: the load so far, and
  // how many of them are not already held.
  :carry 0 min 0 max 900
  :fresh 0 min 0 max 50

  passage hands_full { You're holding too many things already! }

  // Zork has no HELP; the Empire answers it in its own voice rather than
  // with every verb against every thing in sight.
  passage help {
    You are in the Great Underground Empire. Tell it what to do in plain English: NORTH, SOUTH, EAST, WEST, NORTHEAST and the other diagonals, UP and DOWN (N, S, E, W, NE, U, D and so on) to move; LOOK (or L) to look around; INVENTORY (or I) to see what you carry; and TAKE, DROP, OPEN, CLOSE, READ, EXAMINE, PUT something IN something, TURN ON something, ATTACK something WITH something, for the rest. SCORE and DIAGNOSE tell you how you are doing. A room is described in full the first time you enter it and named after that, unless you ask for VERBOSE; BRIEF goes back to that, and SUPERBRIEF names every room and no more.
  }

  passage inventory {
    {if self.count(Thing) == 0}You are empty-handed.{else}You are carrying:{for t: Thing in self}

    A {t.short}{if t.is(Lamp)}{if t.get(:lit)} (providing light){/if}{/if}

    {t.inside_lines}{/for}{/if}
  }

  passage yuk {
    {one of}A valiant attempt.{or}You can't be serious.{or}An interesting idea...{or}What a concept!{/one of}
  }

  passage rank {{if self.get(:score) >= 350}Master Adventurer{else if self.get(:score) > 330}Wizard{else if self.get(:score) > 300}Master{else if self.get(:score) > 200}Adventurer{else if self.get(:score) > 100}Junior Adventurer{else if self.get(:score) > 50}Novice Adventurer{else if self.get(:score) > 25}Amateur Adventurer{else}Beginner{/if}}

  passage score_line {
    Your score is {self.get(:score)} (total of 350 points), in {self.get(:moves)} {if self.get(:moves) == 1}move{else}moves{/if}.

    This gives you the rank of {self.rank}.
  }

  // What carrying weighs, as Zork weighs it: a load of 100 at most.
  on :entered (item, from) {
    if (item.is(Thing)) { self.adjust(:load, item.get(:size)) }
    if (item.is(Treasure)) {
      if (item.get(:value) > 0) {
        self.adjust(:score, item.get(:value))
        send item :claimed
      }
    }
  }
  on :left (item, to) {
    if (item.is(Thing)) { self.adjust(:load, 0 - item.get(:size)) }
  }

  on :scored (from, value) { self.adjust(:score, value) }

  // Asked to go somewhere no exit from here leads (up the tree by its
  // branches, say): through the world's gate.
  on :travel (from, value) {
    self.set(:dest, value)
    send underground_caverns :open_gate
  }

  // Light: how many lit lamps are carried, and whether the room is dark
  // without them.
  on :light (from, value) {
    self.adjust(:light, value)
    broadcast :relight
  }
  on :room_lit (from, value) { self.set(:room_dark, !value) }

  // Going somewhere, as Zork's GOTO does it: into a dark place, the
  // warning; from one dark place into another without a light, four times
  // in five, the grue; and into the Cellar while the trap door stands open
  // above, the crash. These are said before the room is described, and
  // what is told on arrival (the sword's glow, the songbird) after it.
  as actor for go {
    do {
      self.adjust(:moves, 1)
      // A lamp lights the way in the hand or in an open bag, as the room's
      // own `lit` sees it.
      self.set(:own_light, self.get(:light) > 0)
      each b: Box in self {
        if (b.get(:open)) {
          each l: Lamp in b { if (l.get(:lit)) { self.set(:own_light, true) } }
        }
      }
      if (here.is(DarkRoom)) {
        if (!self.get(:own_light) && !here.get(:alight)) {
          if (self.get(:room_dark) && !chance(5)) {
            self.set(:devoured, true)
            send self :grue
          } else {
            say "You have moved into a dark place."
          }
        }
      }
      if (here.is(Room)) {
        if (here.get(:crash)) { say "The trap door crashes shut, and you hear someone barring it." }
      }
    }
  }

  on :grue {
    self.set(:devoured, false)
    tell self "Oh, no! A lurking grue slithered into the room and devoured you!"
    send self :die
  }

  // Arriving somewhere: the sword's glow, and in the forest, now and then,
  // the songbird.
  on :moved (from, to) {
    if (to.is(Room) && !self.get(:devoured)) {
      if (!to.is(DarkRoom)) { self.set(:room_dark, false) }
      send self :settle with to.get(:glow)
      if (to.is(Forest) && chance(7)) { tell self "You hear in the distance the chirping of a song bird." }
    }
  }

  on :settle (from, value) {
    each s: Sword in self {
      if (s.get(:glow) != value) {
        if (value == 2) { tell self "Your sword has begun to glow very brightly." }
        else if (value == 1) { tell self "Your sword is glowing with a faint blue glow." }
        else { tell self "Your sword is no longer glowing." }
        send s :glow with value
      }
    }
  }

  on :troll_gone {
    each s: Sword in self {
      if (s.get(:glow) > 0) {
        tell self "Your sword is no longer glowing."
        send s :glow with 0
      }
    }
  }

  // The troll's blow, and what it does. `value` is Zork's blow result:
  // 1 missed, 2 knocked out, 3 killed, 4 lightly wounded, 6 staggered.
  // The line is drawn from Zork's own for that result.
  passage weapon_name {{if self.count(Sword) > 0}sword{else if self.count(Knife) > 0}nasty knife{else}bloody axe{/if}}
  on :struck (from, value) {
    if (value == 1) {
      tell self "{one of}The troll swings his axe, but it misses.{or}The troll's axe barely misses your ear.{or}The axe sweeps past as you jump aside.{or}The axe crashes against the rock, throwing sparks!{/one of}"
    } else if (value == 2) {
      tell self "The flat of the troll's axe hits you delicately on the head, knocking you out."
      if (random(9) < 2) {
        tell self "{one of}The troll hesitates, fingering his axe.{or}The troll scratches his head ruminatively:  Might you be magically protected, he wonders?{/one of}"
      } else {
        tell self "Conquering his fears, the troll puts you to death."
        tell self "It appears that that last blow was too much for you. I'm afraid you are dead."
        send self :die
      }
    } else if (value == 3) {
      tell self "{one of}The troll neatly removes your head.{or}The troll's axe stroke cleaves you from the nave to the chops.{or}The troll's axe removes your head.{/one of}"
      tell self "It appears that that last blow was too much for you. I'm afraid you are dead."
      send self :die
    } else if (value == 4) {
      tell self "{one of}The axe gets you right in the side. Ouch!{or}The flat of the troll's axe skins across your forearm.{or}The troll's swing almost knocks you over as you barely parry in time.{or}The troll swings his axe, and it nicks your arm as you dodge.{/one of}"
      self.adjust(:wounds, 1)
      self.adjust(:fight, -1)
      if (self.get(:fight) <= 0) {
        tell self "It appears that that last blow was too much for you. I'm afraid you are dead."
        send self :die
      } else if (!self.get(:healing)) {
        self.set(:healing, true)
        wake in 10 minutes
      }
    } else {
      // Staggered, or one time in four disarmed (Zork's LOSE-WEAPON).
      if (self.count(Weapon) > 0 && chance(4)) {
        tell self "{one of}The axe hits your {self.weapon_name} and knocks it spinning.{or}The axe knocks your {self.weapon_name} out of your hand. It falls to the floor.{/one of}"
        if (self.count(Sword) > 0) {
          each w: Sword in self { move w to troll_room }
        } else if (self.count(Knife) > 0) {
          each w: Knife in self { move w to troll_room }
        } else {
          each w: Axe in self { move w to troll_room }
        }
      } else {
        tell self "{one of}The troll hits you with a glancing blow, and you are momentarily stunned.{or}The troll swings; the blade turns on your armor but crashes broadside into your head.{or}You stagger back under a hail of axe strokes.{or}The troll's mighty blow drops you to your knees.{/one of}"
        self.set(:staggered, true)
      }
    }
  }

  // Wounds heal, a light wound at a time.
  on :woke (elapsed) {
    self.set(:healing, false)
    if (self.get(:wounds) > 0) {
      self.adjust(:wounds, -1)
      self.adjust(:fight, 1)
      if (self.get(:wounds) > 0) {
        self.set(:healing, true)
        wake in 10 minutes
      }
    }
  }

  // JIGS-UP.
  on :die {
    self.adjust(:score, -10)
    self.adjust(:deaths, 1)
    self.set(:wounds, 0)
    self.set(:fight, 2)
    self.set(:staggered, false)
    tell self "****  You have died  ****"
    if (self.get(:deaths) >= 3) {
      tell self "You clearly are a suicidal maniac.  We don't allow psychotics in the cave, since they may harm other adventurers.  Your remains will be installed in the Land of the Living Dead, where your fellow adventurers may gloat over them."
      tell self score_line
      self.set(:dest, :living_dead)
    } else {
      tell self "Now, let's take a look here... Well, you probably deserve another chance.  I can't quite fix you up completely, but you can't have everything."
      self.set(:dest, :forest_1)
    }
    send underground_caverns :open_gate
  }

  // The gate is open: go where the world sends you.
  on :gate_open {
    if (self.get(:dest) == :living_dead) {
      move self to land_of_the_living_dead
    } else if (self.get(:dest) == :path) {
      move self to forest_path
    } else if (self.get(:dest) == :up_a_tree) {
      move self to up_a_tree
    } else if (self.get(:dest) == :kitchen) {
      move self to kitchen
    } else if (self.get(:dest) == :behind) {
      move self to behind_house
    } else if (self.get(:dest) == :west_side) {
      move self to west_of_house
    } else if (self.get(:dest) == :north_side) {
      move self to north_of_house
    } else if (self.get(:dest) == :south_side) {
      move self to south_of_house
    } else {
      each t: Thing in self {
        if (t.is(Lamp)) {
          move t to living_room
        } else if (t.is(Treasure)) {
          let r = random(3)
          if (r == 0) { move t to attic }
          else if (r == 1) { move t to cellar }
          else { move t to troll_room }
        } else {
          let n = random(10)
          if (n == 0) { move t to west_of_house }
          else if (n == 1) { move t to north_of_house }
          else if (n == 2) { move t to south_of_house }
          else if (n == 3) { move t to behind_house }
          else if (n == 4) { move t to forest_1 }
          else if (n == 5) { move t to forest_2 }
          else if (n == 6) { move t to forest_3 }
          else if (n == 7) { move t to forest_path }
          else if (n == 8) { move t to clearing }
          else { move t to grating_clearing }
        }
      }
      move self to forest_1
    }
    send underground_caverns :close_gate
  }

  // Taking and dropping several things at once, as Zork does: each answered
  // with its name before it. Zork's `all` leaves out what is already held;
  // here `all` and a list of names arrive alike, so what is already held is
  // left out of any list that has something else in it.
  as actor for take {
    do {
      self.adjust(:moves, 1)
      self.set(:carry, self.get(:load))
      self.set(:fresh, 0)
      let several = target.count > 1
      each t of target { if (!self.holds(t)) { self.adjust(:fresh, 1) } }
      each t of target {
        if (t.is(Thing)) {
          if (several && self.holds(t) && self.get(:fresh) > 0) { }
          else if (self.holds(t)) { say "{if several}{t.short}: {/if}You already have that!" }
          else if (t.is(Portable)) {
            if (self.get(:carry) + t.get(:size) > 100) { say "{if several}{t.short}: {/if}Your load is too heavy." }
            else {
              move t to self
              self.adjust(:carry, t.get(:size))
              say "{if several}{t.short}: {/if}Taken."
            }
          }
          else { say "{if several}{t.short}: {/if}{t.no_take}" }
        }
        else { say yuk }
      }
    }
  }

  as actor for drop {
    do {
      self.adjust(:moves, 1)
      let several = target.count > 1
      each t of target {
        if (here.is(TreeTop)) {
          if (t.is(Nest)) {
            if (t.count(Egg) > 0) { say "{if several}{t.short}: {/if}The nest falls to the ground, and the egg spills out of it, seriously damaged." }
            else { say "{if several}{t.short}: {/if}The bird's nest falls to the ground." }
          } else if (t.is(Egg)) {
            say "{if several}{t.short}: {/if}The egg falls to the ground and springs open, seriously damaged. {t.spill}"
          } else {
            say "{if several}{t.short}: {/if}The {t.short} falls to the ground."
          }
          move t to here
        }
        else {
          move t to here
          say "{if several}{t.short}: {/if}Dropped."
        }
      }
    }
  }

  as actor for put {
    do {
      self.adjust(:moves, 1)
      if (item == container) { say "How can you do that?" }
      else if (item.is(Portable)) {
        if (container.holds(item)) { say "The {item.short} is already in the {container.short}." }
        else {
          move item to container
          say "Done."
        }
      }
      else if (item.is(Thing)) { say "{item.no_take}" }
      else { say yuk }
    }
  }

  as actor for attack {
    do {
      self.adjust(:moves, 1)
      if (target.is(Troll)) {
        if (self.get(:staggered)) {
          self.set(:staggered, false)
          say "You are still recovering from that last blow, so your attack is ineffective."
          send target :blow with 0
        } else if (bound weapon) {
          if (weapon.is(Weapon)) {
            send target :blow with weapon.get(:wcode)
            say "{target.hit_line}"
          }
          else if (weapon.is(Thing)) { say "Trying to attack the troll with a {weapon.short} is suicidal." }
          else { say "Trying to attack a troll with your bare hands is suicidal." }
        } else if (self.count(Sword) > 0) {
          say "(with the sword)"
          send target :blow with 1
          say "{target.hit_line}"
        } else if (self.count(Knife) > 0) {
          say "(with the nasty knife)"
          send target :blow with 2
          say "{target.hit_line}"
        } else if (self.count(Axe) > 0) {
          say "(with the bloody axe)"
          send target :blow with 3
          say "{target.hit_line}"
        } else {
          say "Trying to attack a troll with your bare hands is suicidal."
        }
      } else if (target.is(Thing)) {
        say "I've known strange people, but fighting a {target.short}?"
      } else {
        say "I've known strange people, but fighting that?"
      }
    }
  }

  as actor for jump {
    do {
      self.adjust(:moves, 1)
      if (here.is(TreeTop)) {
        say "In a feat of unaccustomed daring, you manage to land on your feet without killing yourself."
        self.set(:dest, :path)
        send underground_caverns :open_gate
      } else if (here.is(Perilous)) {
        say "This was not a very safe place to try jumping."
        say "{one of}You should have looked before you leaped.{or}In the movies, your life would be passing before your eyes.{or}Geronimo...{/one of}"
        send self :die
      } else {
        say "{one of}Very good. Now you can go to the second grade.{or}Are you enjoying yourself?{or}Wheeeeeeeeee!!!!!{or}Do you expect me to applaud?{/one of}"
      }
    }
  }

  as actor for score { do { say score_line } }

  as actor for diagnose {
    do {
      self.adjust(:moves, 1)
      say "{if self.get(:wounds) == 0}You are in perfect health.{else if self.get(:wounds) == 1}You have a light wound.{else if self.get(:wounds) == 2}You have a serious wound.{else if self.get(:wounds) == 3}You have several wounds.{else}You have serious wounds.{/if}"
      say "You can {if self.get(:fight) <= 0}expect death soon{else if self.get(:fight) == 1}be killed by one more light wound{else if self.get(:fight) == 2}be killed by a serious wound{else if self.get(:fight) == 3}survive one serious wound{else}survive several wounds{/if}."
      if (self.get(:deaths) == 1) { say "You have been killed once." }
      else if (self.get(:deaths) == 2) { say "You have been killed twice." }
    }
  }

  as actor for xyzzy { do { self.adjust(:moves, 1)  say "A hollow voice says \"Fool.\"" } }
  as actor for hello {
    do {
      self.adjust(:moves, 1)
      say "{one of}Hello.{or}Good day.{or}Nice weather we've been having lately.{or}Goodbye.{/one of}"
    }
  }
  as actor for yell { do { self.adjust(:moves, 1)  say "Aaaarrrrgggghhhh!" } }
  as actor for zork { do { self.adjust(:moves, 1)  say "At your service!" } }
  as actor for curse { do { self.adjust(:moves, 1)  say "Such language in a high-class establishment like this!" } }

  // Every other verb counts a move, as Zork's CLOCKER does; `score`,
  // `verbose`, `brief`, `superbrief`, `quit`, `restart`, `save` and
  // `restore`, which are about the game rather than in it, do not.
  as actor for look       { do { self.adjust(:moves, 1) } }
  as actor for examine    { do { self.adjust(:moves, 1) } }
  as actor for inventory  { do { self.adjust(:moves, 1) } }
  as actor for wait       { do { self.adjust(:moves, 1) } }
  as actor for open       { do { self.adjust(:moves, 1) } }
  as actor for close      { do { self.adjust(:moves, 1) } }
  as actor for read       { do { self.adjust(:moves, 1) } }
  as actor for look_in    { do { self.adjust(:moves, 1) } }
  as actor for look_under { do { self.adjust(:moves, 1) } }
  as actor for lamp_on    { do { self.adjust(:moves, 1) } }
  as actor for lamp_off   { do { self.adjust(:moves, 1) } }
  as actor for shift      { do { self.adjust(:moves, 1) } }
  as actor for raise      { do { self.adjust(:moves, 1) } }
  as actor for eat        { do { self.adjust(:moves, 1) } }
  as actor for drink      { do { self.adjust(:moves, 1) } }
  as actor for wind       { do { self.adjust(:moves, 1) } }
  as actor for tally      { do { self.adjust(:moves, 1) } }
  as actor for smell      { do { self.adjust(:moves, 1) } }
  as actor for listen     { do { self.adjust(:moves, 1) } }
  as actor for climb_up   { do { self.adjust(:moves, 1) } }
  as actor for climb_down { do { self.adjust(:moves, 1) } }
  as actor for unlock     { do { self.adjust(:moves, 1) } }
  as actor for knock      { do { self.adjust(:moves, 1) } }
  as actor for walk_around { do { self.adjust(:moves, 1) } }
  as actor for through    { do { self.adjust(:moves, 1) } }
  // A gift to the troll leaves the hand first, onto the floor at his feet,
  // since nothing in a visitor's hands is in his reach; he takes it from
  // there, or lets it lie.
  as actor for give {
    do {
      self.adjust(:moves, 1)
      if (recipient.is(Troll)) { move item to here }
    }
  }
  as actor for walk_about { do { self.adjust(:moves, 1)  say "Use compass directions for movement." } }

  // Zork's DIG: with nothing else to dig with, a pair of hands. Zork asks
  // what to dig in when told only `dig`; the parser here cannot ask, so the
  // answer is the one Zork gives once it knows.
  as actor for dig {
    do {
      self.adjust(:moves, 1)
      if (bound tool) {
        if (tool.is(Thing)) { say "Digging with a {tool.short} is silly." }
        else { say "Digging with a pair of hands is silly." }
      } else { say "Digging with a pair of hands is silly." }
    }
  }
  as actor for dig_here { do { self.adjust(:moves, 1)  say "Digging with a pair of hands is silly." } }
  as actor for lock       { do { self.adjust(:moves, 1) } }
  as actor for verbose    { do { self.set(:mode, :verbose)  say "Maximum verbosity." } }
  as actor for brief      { do { self.set(:mode, :brief)  say "Brief descriptions." } }
  as actor for superbrief { do { self.set(:mode, :superbrief)  say "Superbrief descriptions." } }
  as actor for quit {
    do {
      say score_line
      say "There is no quitting the Great Underground Empire from inside it. Walk away whenever you like; it will keep your place, and your score, until you come back."
    }
  }
  as actor for restart {
    do { say "The Great Underground Empire cannot be started over from inside it. What is done here stays done." }
  }
  as actor for save {
    do { say "The Empire keeps your place for you whether you ask or not. There is nothing to save." }
  }
  as actor for restore {
    do { say "The Empire keeps your place for you whether you ask or not. There is nothing to restore." }
  }
}
