{
  "about": "Zork's sayings: xyzzy, hello, jump, the YUKS, and the verbs the Empire answers in its own voice.",
  "steps": [
    { "arrive": "Marta", "expect": [
      { "reader": "Marta", "kind": "described", "words": "West of House" },
      { "reader": "Marta", "kind": "described", "words": "You are standing in an open field west of a white house, with a boarded front door." },
      { "reader": "Marta", "kind": "described", "words": "There is a small mailbox here." }
    ] },
    { "as": "Marta", "type": "xyzzy", "expect": [
      { "reader": "Marta", "kind": "said", "words": "A hollow voice says \"Fool.\"" }
    ] },
    { "as": "Marta", "type": "plugh", "expect": [
      { "reader": "Marta", "kind": "said", "words": "A hollow voice says \"Fool.\"" }
    ] },
    { "as": "Marta", "type": "hello", "expect": [
      { "reader": "Marta", "kind": "said", "words": "Hello." }
    ] },
    { "as": "Marta", "type": "hello", "expect": [
      { "reader": "Marta", "kind": "said", "words": "Good day." }
    ] },
    { "as": "Marta", "type": "jump", "expect": [
      { "reader": "Marta", "kind": "said", "words": "Do you expect me to applaud?" }
    ] },
    { "as": "Marta", "type": "jump", "expect": [
      { "reader": "Marta", "kind": "said", "words": "Wheeeeeeeeee!!!!!" }
    ] },
    { "as": "Marta", "type": "take house", "expect": [
      { "reader": "Marta", "kind": "said", "words": "An interesting idea..." }
    ] },
    { "as": "Marta", "type": "x board", "expect": [
      { "reader": "Marta", "kind": "described", "words": "The boards are securely fastened." }
    ] },
    { "as": "Marta", "type": "open front door", "expect": [
      { "reader": "Marta", "kind": "said", "words": "The door cannot be opened." }
    ] },
    { "as": "Marta", "type": "read door", "expect": [
      { "reader": "Marta", "kind": "said", "words": "There is no writing on this side." }
    ] },
    { "as": "Marta", "type": "x mailbox", "expect": [
      { "reader": "Marta", "kind": "described", "words": "The small mailbox is closed." }
    ] },
    { "as": "Marta", "type": "score", "expect": [
      { "reader": "Marta", "kind": "said", "words": "Your score is 0 (total of 350 points)." },
      { "reader": "Marta", "kind": "said", "words": "This gives you the rank of Beginner." }
    ] },
    { "as": "Marta", "type": "diagnose", "expect": [
      { "reader": "Marta", "kind": "said", "words": "You are in perfect health." },
      { "reader": "Marta", "kind": "said", "words": "You can be killed by a serious wound." }
    ] },
    { "as": "Marta", "type": "quit", "expect": [
      { "reader": "Marta", "kind": "said", "words": "Your score is 0 (total of 350 points)." },
      { "reader": "Marta", "kind": "said", "words": "This gives you the rank of Beginner." },
      { "reader": "Marta", "kind": "said", "words": "There is no quitting the Great Underground Empire from inside it. Walk away whenever you like; it will keep your place, and your score, until you come back." }
    ] },
    { "as": "Marta", "type": "save", "expect": [
      { "reader": "Marta", "kind": "said", "words": "The Empire keeps your place for you whether you ask or not. There is nothing to save." }
    ] },
    { "as": "Marta", "type": "verbose", "expect": [
      { "reader": "Marta", "kind": "said", "words": "Maximum verbosity." }
    ] },
    { "as": "Marta", "type": "brief", "expect": [
      { "reader": "Marta", "kind": "said", "words": "Brief descriptions are not to be had in this part of the Empire. Every room will tell you everything, every time." }
    ] },
    { "as": "Marta", "type": "foo", "expect": [
      { "reader": "Marta", "kind": "notice", "words": "That sentence isn't one I recognize." }
    ] },
    { "as": "Marta", "type": "z", "expect": [
      { "reader": "Marta", "kind": "said", "words": "Time passes..." }
    ] }
  ]
}
