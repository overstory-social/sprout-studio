// The kinds of portable thing Zork treats specially: weapons, treasures,
// food and drink, and things with writing on them.
import {Portable, Thing} from 'thing'
import {Adventurer} from 'adventurer'
import {eat, drink, read, pour, pour_in, pour_on, :glow, :claimed} from 'verbs'
import {TrophyCase} from 'house'
import {Box} from 'box'

// A weapon, and which one: Zork's melee tables care whether it is the
// sword (which the troll fears most), the knife or the axe.
kind Weapon is Portable {
  :wcode 1 min 1 max 3
}

kind Sword is Weapon {
  :glow 0 min 0 max 2
  on :glow (from, value) { self.set(:glow, value) }
}

kind Knife is Weapon { :wcode 2 }

kind Axe is Weapon { :wcode 3 }

// A treasure pays `:value` the first time it is taken, and `:tvalue` for as
// long as it sits in the trophy case.
kind Treasure is Portable {
  :value 0 min 0 max 50
  :tvalue 0 min 0 max 50
  // Whether it sits in the trophy case: a treasure spoiled there takes
  // back what the case paid for it.
  :cased false
  on :claimed { self.set(:value, 0) }
  on :moved (from, to) { self.set(:cased, to.is(TrophyCase)) }
}

// Something to eat. Eaten, it is gone for good, as in Zork.
kind Food is Portable {
  without as target for eat from Thing
  as target for eat {
    permit {
      if (!actor.holds(self)) { refuse "You're not holding that." }
    }
    do {
      say "Thank you very much. It really hit the spot."
      destroy self
    }
  }
}

// Something with words on it. Reading a thing you are not holding picks it
// up first, as Zork's parser does, and says so.
kind Readable is Portable {
  without as target for read from Thing
  passage words default { {if false}.{/if} }
  as target for read {
    do {
      if (!actor.holds(self)) {
        move self to actor
        say "(Taken)"
      }
      say words
    }
  }
}

// Zork's lunch and clove of garlic, from the brown sack.
kind Lunch is Food {
  grammar { name "lunch"  nouns "food", "sandwich", "dinner"  adjectives "hot", "pepper" }
  passage short { lunch }
  passage ldesc { A hot pepper sandwich is here. }
}

kind Garlic is Food {
  grammar { name "clove of garlic"  nouns "garlic", "clove" }
  :size 4
  passage short { clove of garlic }
  without as target for eat from Food
  as target for eat {
    permit { if (!actor.holds(self)) { refuse "You're not holding that." } }
    do {
      say "What the heck! You won't make friends this way, but nobody around here is too friendly anyhow. Gulp!"
      destroy self
    }
  }
}

// Water, from the glass bottle: it slips through the fingers, and is drunk
// where it stands.
kind Water is Thing {
  grammar { name "quantity of water"  nouns "water", "liquid", "h2o" }
  :size 4
  passage short { quantity of water }
  passage no_take { It's in the bottle. Perhaps you should take that instead. }
  without as target for drink from Thing
  as target for drink {
    do {
      say "Thank you very much. I was rather thirsty (from all this talking, probably)."
      destroy self
    }
  }

  // Poured, as Zork's WATER-F takes it: on the floor, into anything but
  // the bottle it is in, or over something, it is gone.
  without as target for pour from Thing
  as target for pour {
    do {
      say "The water spills to the floor and evaporates."
      destroy self
    }
  }
  without as item for pour_in from Thing
  as item for pour_in {
    do {
      if (container.is(Box)) {
        if (container.holds(self)) { say "The water slips through your fingers." }
        else {
          say "The water leaks out of the {container.short} and evaporates immediately."
          destroy self
        }
      } else if (container.is(Thing)) {
        say "The water leaks out of the {container.short} and evaporates immediately."
        destroy self
      } else {
        say "The water spills to the floor and evaporates."
        destroy self
      }
    }
  }
  without as item for pour_on from Thing
  as item for pour_on {
    do {
      if (target.is(Thing)) { say "The water spills over the {target.short}, to the floor, and evaporates." }
      else { say "The water spills to the floor and evaporates." }
      destroy self
    }
  }
}
