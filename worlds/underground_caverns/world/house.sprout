// The white house: the Kitchen, the Attic and the Living Room, and the
// things in them. The kitchen window is one window seen from two rooms, and
// the trap door one door; each side keeps the other in step by a message
// the world lets pass between rooms.
import * as sprout from 'sprout'
import {Thing, Portable, Scenery} from 'thing'
import {Box, Bag} from 'box'
import {Lamp} from 'lamp'
import {Sword, Knife, Treasure, Food, Water, Lunch, Garlic} from 'items'
import {Room, DarkRoom, Perilous} from 'room'
import {Adventurer} from 'adventurer'
import {Stairs} from 'scenery'
import {open, close, look_in, read, shift, raise, look_under, smell, eat, :window_sync, :trap, :trap_sync, :rug_moved, :scored} from 'verbs'
import {behind_house} from 'above_ground'
import {cellar} from 'cellar'

// The room outside the kitchen window.
kind Outdoors { }

kind KitchenWindow is Scenery {
  grammar { name "kitchen window"  nouns "window"  adjectives "small" }
  :open false
  :opened_once false
  passage short { kitchen window }

  describe {
    if (!self.get(:opened_once)) { text "The window is slightly ajar, but not enough to allow entry." }
    else if (self.get(:open)) { text "The kitchen window is open, but I can't tell what's beyond it." }
    else { text "The kitchen window is closed." }
  }

  without as target for open from Thing
  without as target for close from Thing
  without as target for look_in from Thing
  as target for open {
    permit { if (self.get(:open)) { refuse "It is already open." } }
    do {
      self.set(:open, true)
      self.set(:opened_once, true)
      say "With great effort, you open the window far enough to allow entry."
      broadcast :window_sync with true
    }
  }
  as target for close {
    permit { if (!self.get(:open)) { refuse "It is already closed." } }
    do {
      self.set(:open, false)
      self.set(:opened_once, true)
      say "The window closes (more easily than it opened)."
      broadcast :window_sync with false
    }
  }
  as target for look_in {
    do {
      if (here.is(Outdoors)) { say "You can see what appears to be a kitchen." }
      else { say "You can see a clear area leading towards a forest." }
    }
  }
  on :window_sync (from, value) {
    self.set(:open, value)
    self.set(:opened_once, true)
  }
}

object kitchen is Room, Perilous in underground_caverns {
  grammar {
    name "Kitchen"
    exit east "window"  -> behind_house when (self.get(:window_open))
    exit east "window"  refuse "The kitchen window is closed."
    exit out  "outside" -> behind_house when (self.get(:window_open))
    exit out  "outside" refuse "The kitchen window is closed."
    exit west "west"    -> living_room
    exit up   "stairs"  -> attic
    exit down "chimney" refuse "Only Santa Claus climbs down chimneys."
  }
  :value 10
  :window_open false
  passage body {
    You are in the kitchen of the white house. A table seems to have been used recently for the preparation of food. A passage leads to the west and a dark staircase can be seen leading upward. A dark chimney leads down and to the east is a small window which is {if self.get(:window_open)}open.{else}slightly ajar.{/if}
  }
  on :window_sync (from, value) { self.set(:window_open, value) }

  // The lunch, the garlic and the water are made the first time anyone
  // comes in, so that eating and drinking may unmake them.
  :stocked false
  on :entered (item, from) {
    if (item.is(Adventurer) && !self.get(:stocked)) {
      self.set(:stocked, true)
      spawn Lunch in table.sack
      spawn Garlic in table.sack
      spawn Water in table.bottle
    }
  }

  object table is Box {
    grammar { name "kitchen table"  nouns "table" }
    :open true
    :surface true
    :ndesc true
    :capacity 50
    passage short { kitchen table }

    object sack is Bag {
      grammar { name "brown sack"  nouns "bag", "sack"  adjectives "elongated", "smelly" }
      :has_fdesc true
      :size 9
      :capacity 9
      passage short { brown sack }
      passage fdesc { On the table is an elongated brown sack, smelling of hot peppers. }

      without as target for smell from Thing
      as target for smell {
        do {
          if (self.count(Food) > 0) { say "It smells of hot peppers." } else { say "It smells like a brown sack." }
        }
      }
    }

    object bottle is Bag {
      grammar { name "glass bottle"  nouns "bottle", "container"  adjectives "clear", "glass" }
      :has_fdesc true
      :transparent true
      :capacity 4
      passage short { glass bottle }
      passage fdesc { A bottle is sitting on the table. }
    }
  }

  object window is KitchenWindow
  object stairs is Stairs
  object chimney_flue is Scenery {
    grammar { name "chimney"  adjectives "dark", "narrow" }
    passage short { chimney }
    describe { text "The chimney leads downward, and looks climbable." }
  }
}

object attic is DarkRoom in underground_caverns {
  grammar {
    name "Attic"
    exit down "stairs" -> kitchen
  }
  passage body { This is the attic. The only exit is a stairway leading down. }

  object rope is Portable {
    grammar { nouns "rope", "hemp", "coil"  adjectives "large" }
    :has_fdesc true
    :size 10
    passage short { rope }
    passage fdesc { A large coil of rope is lying in the corner. }
  }

  object table is Box {
    grammar { name "table" }
    :open true
    :surface true
    :ndesc true
    :capacity 40
    passage short { table }
    on :left (item, to) { self.set(:ndesc, false) }

    object knife is Knife {
      grammar { name "nasty knife"  nouns "knife", "knives", "blade"  adjectives "nasty", "unrusty" }
      :has_fdesc true
      passage short { nasty knife }
      passage fdesc { On a table is a nasty-looking knife. }
    }
  }
  object stairs is Stairs
}

object living_room is Room in underground_caverns {
  grammar {
    name "Living Room"
    exit east "east"      -> kitchen
    exit west "west"      refuse "The door is nailed shut."
    exit down "trap door" -> cellar when (self.get(:trap_open))
    exit down "trap door" refuse "The trap door is closed." when (self.get(:rug_moved))
  }
  :rug_moved false
  :trap_open false
  passage body {
    You are in the living room. There is a doorway to the east, a wooden door with strange gothic lettering to the west, which appears to be nailed shut, a trophy case, {if self.get(:rug_moved) && self.get(:trap_open)}and a rug lying beside an open trap door.{else if self.get(:rug_moved)}and a closed trap door at your feet.{else if self.get(:trap_open)}and an open trap door at your feet.{else}and a large oriental rug in the center of the room.{/if}
  }

  on :rug_moved (from) { self.set(:rug_moved, true) }
  on :trap (from, value) {
    self.set(:trap_open, value)
    broadcast :trap_sync with value
  }
  on :trap_sync (from, value) { self.set(:trap_open, value) }

  object trophy_case is TrophyCase
  object lamp is Lamp {
    grammar { name "brass lantern"  nouns "lamp", "lantern", "light"  adjectives "brass" }
    :has_fdesc true
    :size 15
    passage short { brass lantern }
    passage fdesc { A battery-powered brass lantern is on the trophy case. }
    passage ldesc { There is a brass lantern (battery-powered) here. }
    describe {
      if (self.get(:lit)) { text "The lamp is on." } else { text "The lamp is turned off." }
    }
  }
  object sword is Sword {
    grammar { nouns "sword", "orcrist", "glamdring", "blade"  adjectives "elvish", "old", "antique" }
    :has_fdesc true
    :size 30
    passage short { sword }
    passage fdesc { Above the trophy case hangs an elvish sword of great antiquity. }
    describe {
      if (self.get(:glow) == 2) { text "Your sword is glowing very brightly." }
      else if (self.get(:glow) == 1) { text "Your sword is glowing with a faint blue glow." }
      else { text "There's nothing special about the sword." }
    }
  }
  object rug is Rug {
    object trap_door is TrapDoor
  }
  object wooden_door is Scenery {
    grammar { name "wooden door"  nouns "door", "lettering", "writing", "engravings"  adjectives "wooden", "gothic", "strange", "west" }
    passage short { wooden door }
    without as target for open from Thing
    without as target for read from Thing
    as target for open { do { say "The door cannot be opened." } }
    as target for read { do { say "The engravings translate to \"This space intentionally left blank.\"" } }
    describe { text "The engravings translate to \"This space intentionally left blank.\"" }
  }
  object nails is Scenery {
    grammar { nouns "nails", "nail" }
    passage short { nails }
    passage no_take { The nails, deeply imbedded in the door, cannot be removed. }
  }
  object stairs is Stairs
}

// The trophy case. It pays a treasure's worth to everyone in the Living
// Room when it goes in, and takes it back when it comes out.
kind TrophyCase is Box {
  grammar { name "trophy case"  nouns "case"  adjectives "trophy" }
  :transparent true
  :ndesc true
  :capacity 50
  passage short { trophy case }
  passage no_take { The trophy case is securely fastened to the wall. }
  passage header { Your collection of treasures consists of: }

  on :entered (item, from) {
    if (item.is(Treasure)) {
      each a: Adventurer in underground_caverns.living_room { send a :scored with item.get(:tvalue) }
    }
  }
  on :left (item, to) {
    if (item.is(Treasure)) {
      each a: Adventurer in underground_caverns.living_room { send a :scored with 0 - item.get(:tvalue) }
    }
  }
}

// The rug hides the trap door until it is moved, once, aside.
kind Rug is Scenery {
  contains
  :moved false
  pass any (self.get(:moved))
  grammar { name "carpet"  nouns "rug"  adjectives "large", "oriental" }
  passage short { carpet }
  passage no_take { The rug is extremely heavy and cannot be carried. }

  without as target for shift from Thing
  as target for shift {
    do {
      if (self.get(:moved)) {
        say "Having moved the carpet previously, you find it impossible to move it again."
      } else {
        self.set(:moved, true)
        say "With a great effort, the rug is moved to one side of the room, revealing the dusty cover of a closed trap door."
        send living_room :rug_moved
      }
    }
  }
  without as target for raise from Thing
  as target for raise {
    do {
      if (self.get(:moved)) { say "The rug is too heavy to lift." }
      else { say "The rug is too heavy to lift, but in trying to take it you have noticed an irregularity beneath it." }
    }
  }
  without as target for look_under from Thing
  as target for look_under {
    do {
      if (self.get(:moved)) { say "There is nothing but dust there." }
      else { say "Underneath the rug is a closed trap door. As you drop the corner of the rug, the trap door is once again concealed from view." }
    }
  }
}

// The trap door, from the Living Room.
kind TrapDoor is Scenery {
  grammar { name "trap door"  nouns "door", "trapdoor", "trap-door", "cover"  adjectives "trap", "dusty" }
  :open false
  passage short { trap door }
  describe {
    if (self.get(:open)) { text "The trap door is open, but I can't tell what's beyond it." }
    else { text "The trap door is closed." }
  }

  without as target for open from Thing
  without as target for close from Thing
  without as target for raise from Thing
  without as target for look_under from Thing
  as target for open {
    permit { if (self.get(:open)) { refuse "It is already open." } }
    do {
      self.set(:open, true)
      say "The door reluctantly opens to reveal a rickety staircase descending into darkness."
      send living_room :trap with true
    }
  }
  as target for raise {
    permit { if (self.get(:open)) { refuse "It is already open." } }
    do {
      self.set(:open, true)
      say "The door reluctantly opens to reveal a rickety staircase descending into darkness."
      send living_room :trap with true
    }
  }
  as target for close {
    permit { if (!self.get(:open)) { refuse "It is already closed." } }
    do {
      self.set(:open, false)
      say "The door swings shut and closes."
      send living_room :trap with false
    }
  }
  as target for look_under {
    do {
      if (self.get(:open)) { say "You see a rickety staircase descending into darkness." }
      else { say "It's closed." }
    }
  }
  on :trap_sync (from, value) { self.set(:open, value) }
}
