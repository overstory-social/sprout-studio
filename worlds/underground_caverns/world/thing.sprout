// Everything in the Empire that a visitor can see and name. A thing answers
// each of Zork's verbs with Zork's default refusal; a thing that does
// something better leaves the default out with `without` and writes its own.
//
// Zork describes a thing in a room by its first description (FDESC) until it
// has been moved, and by its long one (LDESC) after, or by "There is a ...
// here." when it has none; `here_line` is that rule. A thing marked `:ndesc`
// (Zork's NDESCBIT) is never listed.
import {take, knock, walk_around, through, give, open, close, read, look_in, look_under, lamp_on, lamp_off, shift, raise, eat, drink, wind, tally, smell, listen, unlock, lock, climb_up, climb_down, pour, pour_in, pour_on, mung, :fall, :landed} from 'verbs'

kind Thing {
  grammar { article the }

  :touched false
  :has_fdesc false
  :ndesc false
  :falling false
  :size 5 min 0 max 100
  // Zork's DOORBIT, for knocking.
  :door false

  passage short default { thing }
  passage fdesc default { {self.ldesc} }
  passage ldesc default { There is a {self.short} here. }
  passage here_line default {
    {if !self.get(:ndesc)}{if self.get(:has_fdesc) && !self.get(:touched)}{self.fdesc}{else}{self.ldesc}{/if}{/if}
  }
  passage inside_lines default { {if false}.{/if} }
  passage no_take default {
    {one of}A valiant attempt.{or}You can't be serious.{or}An interesting idea...{or}What a concept!{/one of}
  }
  passage hacked default {{one of}doesn't seem to work.{or}isn't notably helpful.{or}has no effect.{/one of}}

  on :moved (from, to) {
    self.set(:touched, true)
    self.set(:falling, false)
  }
  on :fall   { self.set(:falling, true) }
  on :landed { self.set(:falling, false) }

  as target for open       { do { say "You must tell me how to do that to a {self.short}." } }
  as target for close      { do { say "You must tell me how to do that to a {self.short}." } }
  as target for read       { do { say "How does one read a {self.short}?" } }
  as target for look_in    { do { say "You can't look inside a {self.short}." } }
  as target for look_under { do { say "There is nothing but dust there." } }
  as target for lamp_on    { do { say "You can't turn that on." } }
  as target for lamp_off   { do { say "You can't turn that off." } }
  as target for shift      { do { say "You can't move the {self.short}." } }
  as target for raise      { do { say "Playing in this way with the {self.short} {self.hacked}" } }
  as target for eat        { do { say "I don't think that the {self.short} would agree with you." } }
  as target for drink      { do { say "I don't think that the {self.short} would agree with you." } }
  as target for wind       { do { say "You cannot wind up a {self.short}." } }
  as target for tally      { do { say "You have lost your mind." } }
  as target for smell      { do { say "It smells like a {self.short}." } }
  as target for listen     { do { say "The {self.short} makes no sound." } }
  as target for unlock     { do { say "It doesn't seem to work." } }
  as target for lock       { do { say "It doesn't seem to work." } }
  as target for climb_up   { do { say "You can't do that!" } }
  as target for climb_down { do { say "You can't do that!" } }
  as target for knock {
    do {
      if (self.get(:door)) { say "Nobody's home." }
      else { say "Why knock on a {self.short}?" }
    }
  }
  as target for pour       { do { say "You can't pour that." } }
  as item for pour_in      { do { say "You can't pour that." } }
  as item for pour_on      { do { say "You can't pour that." } }
  as target for mung       { do { say "Nice try." } }
  as target for walk_around { do { say "Use compass directions for movement." } }
  as target for through { do { say "You hit your head against the {self.short} as you attempt this feat." } }
  as recipient for give {
    do {
      if (item.is(Thing)) { say "You can't give a {item.short} to a {self.short}!" }
    }
  }
}

// A thing that can be carried off. Only these answer `take all`.
kind Portable is Thing {
  as target for take { permit { if (false) { refuse "" } } }

  without as target for shift from Thing
  as target for shift { do { say "Moving the {self.short} reveals nothing." } }

  without as target for through from Thing
  as target for through {
    do {
      if (actor.holds(self)) { say "That would involve quite a contortion!" }
      else { say "{one of}A valiant attempt.{or}You can't be serious.{or}An interesting idea...{or}What a concept!{/one of}" }
    }
  }
}

// A thing Zork describes only in its room's own words.
kind Scenery is Thing {
  :ndesc true
}
