// Where an exit leads when the way is shut. Nobody gets in: each refuses
// with the line Zork gives for that way, or, where the way leads into a part
// of the Empire not yet built, with a line in the same voice.
import * as sprout from 'sprout'
import {Nowhere} from 'room'

object boarded_door is Nowhere in underground_caverns {
  passage refusal { The door is boarded and you can't remove the boards. }
}
object boarded_windows is Nowhere in underground_caverns {
  passage refusal { The windows are all boarded. }
}
object no_tree is Nowhere in underground_caverns {
  passage refusal { There is no tree here suitable for climbing. }
}
object machete is Nowhere in underground_caverns {
  passage refusal { You would need a machete to go further west. }
}
object impenetrable is Nowhere in underground_caverns {
  passage refusal { The forest becomes impenetrable to the north. }
}
object impassable is Nowhere in underground_caverns {
  passage refusal { The mountains are impassable. }
}
object undergrowth is Nowhere in underground_caverns {
  passage refusal { The rank undergrowth prevents eastward movement. }
}
object storm_trees is Nowhere in underground_caverns {
  passage refusal { Storm-tossed trees block your way. }
}
object no_higher is Nowhere in underground_caverns {
  passage refusal { You cannot climb any higher. }
}
object chimney is Nowhere in underground_caverns {
  passage refusal { Only Santa Claus climbs down chimneys. }
}
object nailed_door is Nowhere in underground_caverns {
  passage refusal { The door is nailed shut. }
}
object ramp_slide is Nowhere in underground_caverns {
  passage refusal { You try to ascend the ramp, but it is impossible, and you slide back down. }
}
object trap_closed is Nowhere in underground_caverns {
  passage refusal { The trap door is closed. }
}
object grating_closed is Nowhere in underground_caverns {
  passage refusal { The grating is closed! }
}
object troll_fends is Nowhere in underground_caverns {
  passage refusal { The troll fends you off with a menacing gesture. }
}

// The edges of what is built so far.
object canyon_closed is Nowhere in underground_caverns {
  passage refusal {
    The path to the east is roped off. A sign hanging from the rope reads: "CANYON VIEW CLOSED FOR REPAIRS. The Frobozz Magic Scenery Company regrets any inconvenience."
  }
}
object crawlway_unbuilt is Nowhere in underground_caverns {
  passage refusal {
    The crawlway to the south ends, after a few feet, in raw rock. A small brass plaque reads: "EXCAVATION SUSPENDED BY ORDER OF THE FROBOZZ MAGIC TUNNELLING COMPANY."
  }
}
object passage_unbuilt is Nowhere in underground_caverns {
  passage refusal {
    The passage to the east has not been finished. Someone has left a pick leaning against the rock, and a note: "Back soon. -- The Management."
  }
}
object hole_unbuilt is Nowhere in underground_caverns {
  passage refusal {
    You peer into the forbidding hole. It is dark even by the standards of this place, and it does not seem to go anywhere yet. You think better of it.
  }
}

// Where a third death ends a visitor's welcome.
object land_of_the_living_dead is sprout.Place in underground_caverns {
  grammar { name "Land of the Living Dead" article none }
  describe { text remains }
  passage remains {
    Land of the Living Dead

    Your remains lie here, where your fellow adventurers may gloat over them. There is no way out, and nothing further will happen to you in this game.
  }
}
