object diamond_9 is DiamondRoom in underground_caverns_2 {
  grammar {
    name "Oddly-angled Room"
    exit up "up" -> diamond_5
    exit down "down" -> diamond_5
    exit north "north" -> diamond_1
    exit northeast "northeast" -> diamond_2
    exit east "east" -> diamond_3
    exit southeast "southeast" -> diamond_4
    exit south "south" -> diamond_5
    exit southwest "southwest" -> diamond_6
    exit west "west" -> diamond_7
    exit northwest "northwest" -> diamond_8
  }
  :id diamond_9
  object window is DiamondWindow
}

// The club, kept Elsewhere until the first base is reached.
object bat is Bat in elsewhere { }
