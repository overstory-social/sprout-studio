// The garden: its north end, the Gazebo, the Formal Garden, the Topiary,
// the Path Near Stream, the Marble Hall and the Deep Ford; the unicorn
// that comes and goes, and the Wizard's and the unicorn's Elsewhere.
// (2dungeon.zil; I-GARDEN, UNICORN-FCN, GLOBAL-UNICORN-FCN, GAZEBO-FCN,
// HEDGES-F, ROSE-BUSH-FCN, PLACE-MAT-FCN.)
import * as sprout from 'sprout'
import {Thing, Scenery, Creature, Crossable, Portable, Door, Leavable} from 'thing'
import {Room, DarkRoom, Garden, Bridged, ChasmEdge, Watery} from 'room'
import {Box} from 'box'
import {Treasure, Newspaper, PlaceMat, Teapot, StreamWater, LetterOpener, Matchbook} from 'items'
import {Chasm, Stream, Moss, Bridge, dark_tunnel} from 'way_in'
import {carousel_room} from 'carousel'
import {Adventurer} from 'adventurer'
import {ask} from 'sprout'
import {examine} from 'sprout'
import {take, rub, mung, attack, follow, greet, talk, through, cross, smell, listen, look_in, climb_up, shift, give, throw, cut, untie, tie, leave_it, :travel, :bound_away, :come_back, :frighten, :unicorn_at, :secret_door, :unicorn_scene, :unicorn_rides, :unicorn_gone, :consume} from 'verbs'
import {ravine_ledge} from 'ravine'
import {AbsentPrincess} from 'dragon'
import {Brick} from 'volcano'

// The unicorn: an NPC that roams between the north end of the garden and
// Elsewhere, as I-GARDEN moves it, and melts into the hedges when it is
// handled. The gold key hangs round its neck until the princess asks.
kind Unicorn is Creature, sprout.Actor {
  roams
  pass any (true)
  :frightened false
  grammar { name "unicorn"  nouns "animal", "horse", "beast"  adjectives "beautiful", "white" }
  passage short { unicorn }
  passage ldesc { There is a beautiful unicorn here cropping grass. }
  passage arrives { {if false}.{/if} }
  passage leaves { {if false}.{/if} }
  passage not_yours { The unicorn shies away as you approach. }
  passage held_fast { {self.melts} }
  passage melts { The unicorn, unsurprised by this evidence that you are indeed the uncouth sort of vagabond it suspected you were, melts into the hedges and is gone. }
  // Ridden off by the princess, and gone for good (I-UNICORN's REMOVE).
  :gone false
  describe { text "The unicorn shies away as you approach for a closer look, but you do notice a tiny gold key hanging from a red satin ribbon looped around the animal's neck. The ribbon is tied in the sort of bow that is meant to be untied by somebody in particular, a lady by the look of the knot, and the unicorn's look makes it plain that you are not the somebody, and that nobody in this garden is. It will wait for her. You need not." }
  // The princess, home: the unicorn gives up the key to the one she
  // names, since only it may let go of what it carries (I-UNICORN), and
  // goes, as she rides it off; asked by broadcast, since it may have
  // bounded off into the hedges on the very move she wants it (round 4's
  // P1). Where nobody was there to be given the key, the princess asks,
  // and the key goes with them both.
  on :unicorn_rides (from) {
    if (!self.get(:gone)) {
      self.set(:gone, true)
      self.set(:frightened, false)
      if (from.is(Adventurer)) { each k: GoldKey in self { move k to from } }
      else { each k: GoldKey in self { send k :consume } }
      each r: Scenery in self { send r :consume }
      self.set(:unseen, true)
      move self to elsewhere
      broadcast :unicorn_at with false
      broadcast :unicorn_gone with from.is(Adventurer)
    }
  }
  as recipient for give { do { if (item.is(Thing)) { say "The unicorn regards the {item.short} with polite incomprehension, and goes back to cropping grass." } else { say "The unicorn is not interested." } } }
  as aim for throw { do { } }
  as target for greet { do { say "The unicorn listens distractedly, then goes back to cropping grass." } }
  as target for talk { do { say "The unicorn listens distractedly, then goes back to cropping grass." } }
  as target for ask { do { say "The unicorn listens distractedly, then goes back to cropping grass." } }
  as target for follow { do { say "The unicorn shies away as you approach." } }
  as target for listen { do { say "The unicorn crops grass with a small, steady, tearing sound, and now and then snorts at nothing." } }
  as target for smell { do { say "It smells of warm horse and crushed roses, which is a better smell than most of this place has." } }
  as target for rub { do { say melts  send self :frighten } }
  as target for mung { do { say melts  send self :frighten } }
  as target for attack { do { say melts  send self :frighten } }
  as target for shift { do { say melts  send self :frighten } }
  on :frighten {
    self.set(:frightened, true)
    move self to elsewhere
    broadcast :unicorn_at with false
  }
  on :bound_away {
    if (!here.is(Elsewhere)) {
      move self to elsewhere
      broadcast :unicorn_at with false
    }
  }
  on :come_back {
    if (self.get(:gone)) { }
    else if (self.get(:frightened)) { self.set(:frightened, false) }
    else if (here.is(Elsewhere)) {
      move self to garden_north
      broadcast :unicorn_at with true
    }
  }
  object gold_key is GoldKey
  object ribbon is Scenery {
    grammar { name "ribbon"  nouns "satin", "bow", "knot"  adjectives "velvet", "satin", "red" }
    passage short { ribbon }
    describe { text "It is a ribbon of red satin, looped round the unicorn's neck and tied in a bow by somebody the unicorn liked better than it likes you. A tiny gold key hangs from it. The bow is the kind a lady ties, and the kind only she unties." }
    on :consume { finally destroy self }
    // Untied, cut, pulled at or taken: the bow is not the visitor's to
    // undo, and the unicorn keeps it out of reach (round 4's P5).
    passage not_yours_to_untie { The bow was tied for somebody in particular to untie, and the unicorn, which has views about who, lifts its head out of reach of your hands and keeps it there until you stop. She is not in this garden. The unicorn can wait for her; it has been. }
    passage no_take { {self.not_yours_to_untie} }
    as target for untie { do { say not_yours_to_untie } }
    as target for tie { do { say "It is tied already, and better than you could tie it." } }
    as target for shift { do { say not_yours_to_untie } }
    as target for cut { do { say "The unicorn backs a step for every step you take toward it with that in your hand, and the ribbon goes with it. It was tied by somebody the unicorn liked better, and it is not coming off for anybody else." } }
  }
}

// The gold key round the unicorn's neck (GOLD-KEY), until the princess.
kind GoldKey is Treasure {
  grammar { name "delicate gold key"  nouns "key", "treasure"  adjectives "delicate", "gold", "tiny" }
  :ndesc true
  :size 3
  :value 15
  passage short { delicate gold key }
  passage ldesc { There is a delicate gold key here. }
  describe { text "{if self.get(:touched)}The key is tiny and gold and delicate, the kind that opens something small and valuable. It hung from a red satin ribbon round a unicorn's neck until a princess untied it, and whatever it opens is not in this much of the Empire.{else}The key is tiny and gold and delicate, the kind that opens something small and valuable, and it hangs from a red satin ribbon round the unicorn's neck. It is being kept for somebody, and the unicorn knows who, and it is watching you look at it. Whoever she is, she is not in this garden, and nothing you do here will get it off.{/if}" }
  as target for untie { do { say "The key hangs from the ribbon, and the ribbon is tied in a bow that was tied for somebody in particular to untie. The unicorn lifts its head out of reach of your hands. She is not in this garden; the unicorn can wait for her, and you need not." } }
}

// The unicorn as every garden room but the north end knows it (GLOBAL-UNICORN).
kind DistantUnicorn is Scenery, Creature {
  grammar { name "unicorn"  nouns "animal", "key", "ribbon", "horse"  adjectives "beautiful", "white", "gold", "tiny" }
  passage short { unicorn }
  :home true
  // Ridden off for good, and whether the key was given first.
  :gone false
  :given false
  on :unicorn_at (from, value) { self.set(:home, value) }
  on :unicorn_gone (from, value) { self.set(:gone, true)  self.set(:given, value)  self.set(:home, false) }
  passage ridden_off { {if self.get(:given)}The unicorn is gone: the princess rode off on it into the gloom, with its ribbon in her hair, and what hung from the ribbon she gave to you.{else}The unicorn is gone, and the princess with it, into the gloom; she rode off with the ribbon in her hair and the key still on the ribbon, since there was nobody in the garden to give it to.{/if} }
  passage far_off { {if self.get(:gone)}{self.ridden_off}{else if self.get(:home)}The unicorn is way up at the north end of the garden, and so is whatever hangs round its neck.{else}The unicorn is not in sight from here. It was cropping grass at the north end of the garden a little while ago, and will be again when it has forgotten you, which with unicorns is never long; whatever hangs round its neck comes and goes with it.{/if} }
  as target for any { permit { refuse far_off } }
  as recipient for give { permit { refuse far_off } }
  as aim for throw { permit { refuse far_off } }
}

kind Hedges is Scenery {
  grammar { name "hedge"  nouns "hedges", "bushes", "bush"  adjectives "tall", "green" }
  passage short { hedge }
  describe { text "The hedges are tall and dense and very green for things that have never seen the sun, and they hide the cavern walls so well that you can forget, for a moment, that there are walls. They have been clipped by somebody with a steady hand and a long ladder." }
  passage no_take { The hedge is rooted, and you are not. }
  as target for through { do { say "The hedge is too dense to push through, and it pushes back." } }
}
kind TopiaryHedges is Hedges {
  grammar { name "hedge"  nouns "hedges", "bushes", "bush"  adjectives "fantastically", "shaped", "topiary", "clipped" }
  describe { text "The hedges are shaped like various animals: dogs, serpents, dragons, and the like, and they are vaguely troubling to look at." }
}
kind TopiaryAnimals is Scenery {
  grammar { name "topiary animals"  nouns "animals", "animal", "creatures", "creature", "beasts", "shapes"  adjectives "topiary", "misshapen", "huge", "great", "shaped" }
  passage short { topiary animals }
  describe { text "A dragon, a unicorn, a great serpent, a huge misshapen dog, and several human figures, all of them clipped out of hedge by somebody with a steady hand and an unsteady mind. They have not been clipped lately, and the dog in particular has grown a little past itself. You have the feeling they were not standing quite like that when you came in." }
}
// Each of the animals the room names, with the same tell.
kind TopiaryDragon is Scenery {
  grammar { name "topiary dragon"  nouns "dragon"  adjectives "topiary", "hedge", "green" }
  passage short { topiary dragon }
  describe { text "The dragon is the largest of them: a long neck of hedge, a head with two holes clipped in it for eyes, and wings that somebody gave up on halfway along. It is looking at the arbor. A moment ago it was looking at you, or you thought so." }
}
kind TopiarySerpent is Scenery {
  grammar { name "topiary serpent"  nouns "serpent", "snake"  adjectives "topiary", "hedge", "great", "green" }
  passage short { topiary serpent }
  describe { text "The serpent is a single hedge grown long and coiled twice round itself, with a head at the end that comes up to your knee and is open, as far as hedge can be open, at the mouth. The coils are not quite where they were. Or they are, and you are not." }
}
kind TopiaryDog is Scenery {
  grammar { name "topiary dog"  nouns "dog", "hound"  adjectives "topiary", "hedge", "huge", "misshapen" }
  passage short { topiary dog }
  describe { text "The dog is huge and misshapen, as advertised: a hedge the size of a cart on four legs it has grown too many branches to stand on properly, with a head too big for it, hanging low. It has not been clipped in a long time, and it has grown a little past being a dog. It was facing the other way when you came in." }
}
kind TopiaryFigures is Scenery {
  grammar { name "human figures"  nouns "figures", "figure", "people", "humans", "men", "women"  adjectives "human", "several", "topiary", "hedge" }
  passage short { human figures }
  describe { text "The human figures are several, and smaller than the beasts, and worse: a person is harder to clip out of hedge than a dog is, and whoever did these got the arms wrong. They stand in a half ring, facing in, as though waiting for something to arrive in the middle. You are nearer the middle than you were." }
}
// The unicorn as the north end of the garden knows it while it is away:
// unseen while the real one is home, so the two never tie for the word,
// and answering for the key as well, since the key went with it (round
// 3's P6).
kind AbsentUnicorn is DistantUnicorn {
  :unseen true
  :home true
  on :unicorn_at (from, value) { self.set(:home, value)  self.set(:unseen, value) }
  on :unicorn_gone (from, value) { self.set(:gone, true)  self.set(:given, value)  self.set(:home, false)  self.set(:unseen, false) }
  passage far_off { {if self.get(:gone)}{self.ridden_off}{else}The unicorn is not here just now. It bounded off into the hedges, the way it does, and the key went with it, round its neck; it comes back when it has forgotten you, which, with unicorns, is never long.{/if} }
}
// The unicorn the Topiary names is hedge; the real one is the garden's
// stand-in's business (GLOBAL-UNICORN).
kind HedgeUnicorn is DistantUnicorn {
  passage far_off { The unicorn here is hedge, clipped to the shape of one, and not a good likeness: the horn is a branch somebody tied up. The real one{if self.get(:gone)}, wherever the princess has ridden it to,{else if self.get(:home)}, way up at the north end of the garden,{else}, wherever it has got to,{/if} would not be flattered. }
}
kind RoseBush is Scenery {
  grammar { name "roses"  nouns "bush", "arbor", "rose", "rosebed", "flowers"  adjectives "rose", "red" }
  passage short { roses }
  describe { text "The roses are red and heavy-headed and very thorny, and they climb everything they are near. They have the look of roses that have been talked to." }
  passage no_take { You prick your finger trying to take a rose, and jump back annoyed. The rose almost seemed to move its thorns into your path. }
  as target for smell { do { say "They smell as roses smell, only more so, as though they were making a point of it." } }
}
kind Gazebo is Scenery {
  grammar { name "gazebo"  nouns "structure", "building"  adjectives "small", "open", "white", "wooden" }
  passage short { gazebo }
  describe { text "It is a gazebo: a small open structure of white-painted wood, eight-sided, with a railing round it and a roof like a hat, standing in the middle of a bed of roses. It is the sort of thing one takes tea in." }
  // The way in is the adventurer's own (adventurer.sprout), so the step
  // is made before the garden's clock runs, and the unicorn is reported in
  // the room the visitor ends the move in (round 3's P6).
  as target for through { do { say "" } }
}
kind GazeboInside is Gazebo, Leavable {
  describe { text "You are in it. It is white-painted wood, eight-sided, with a bench round the inside of the railing and a tea table in the middle, and the roses have come up through the floorboards in one corner." }
  without as target for through from Gazebo
  as target for through { do { say "You're already in it." } }
  // "leave the gazebo" (round 9's P12) is the way out.
  as target for leave_it { do { send actor :travel with :garden_north  say "" } }
}
kind GardenPath is Scenery {
  grammar { name "path"  nouns "stones", "gravel"  adjectives "manicured", "white", "crushed", "small" }
  passage short { path }
  describe { text "The path is of small crushed white stones, raked, and it winds among the beds with no great interest in getting anywhere." }
}
kind FlowerBeds is Scenery {
  grammar { name "flower beds"  nouns "flowers", "beds", "bed", "flower"  adjectives "flower" }
  passage short { flower beds }
  describe { text "The beds are full of flowers that have never seen the sun and do not seem to have been told, blooming away in the moss-light in colors that are nearly right." }
  passage no_take { The flowers are planted, and you would only be stealing from a wizard. }
}
kind SmallStructure is Scenery {
  grammar { name "small structure"  nouns "structure", "gazebo"  adjectives "small", "white" }
  passage short { small structure }
  describe { text "To the north, through the hedges, a small white structure stands in the middle of a rosebed. It looks like a gazebo. It is a gazebo." }
}
kind Archway is Scenery, Door {
  grammar { name "ruined archway"  nouns "archway", "arch", "vegetation", "vines"  adjectives "ruined", "choked" }
  passage short { ruined archway }
  describe { text "The archway was somebody's idea of a grand entrance, once, and is now mostly vines. The way through it goes east, into the garden." }
  as target for through { do { send actor :travel with :formal_garden  say "" } }
}
kind Ledge is Scenery {
  grammar { name "ledge"  nouns "shelf"  adjectives "small", "narrow", "north" }
  passage short { ledge }
  describe { text "A narrow ledge runs along the north wall of the ravine, a little above the water, and goes somewhere west that is drier than this. A short scramble up the rock face would put you on it." }
  as target for climb_up { do { send actor :travel with :ravine_ledge  say "" } }
}
kind WhirringSound is Scenery {
  grammar { name "whirring sound"  nouns "whirring", "sound", "noise", "whirr"  adjectives "faint", "annoying", "loud" }
  passage short { whirring sound }
  describe { text "The whirring comes from the southwest, steady and mechanical and faintly maddening, as of something very large going round and round and not stopping." }
  as target for listen { do { say "A whirring, steady and mechanical, as of something very large going round and not stopping. It is coming from the southwest." } }
}
kind CrackedMarble is Scenery {
  grammar { name "marble"  nouns "floor", "cracks"  adjectives "fine", "cracked", "broken" }
  passage short { marble }
  describe { text "The marble is fine and veined and polished, and at the north end it is cracked and broken as though the hall had been dropped. A flood, or a collapse of the cave: either is possible, and neither has been tidied up." }
}

// Where the unicorn, the Wizard and his stash are when they are nowhere
// a visitor can reach.
kind Elsewhere is sprout.Place {
  grammar { name "Elsewhere"  article none }
  describe { text "Elsewhere. Nobody comes here, and nothing is described." }
}
object elsewhere is Elsewhere in underground_caverns_2 { }

// The north end and the gazebo say, once the princess has ridden off
// with the key, that the unicorn went and did not wait (round 7's P6).
kind GardenNorth is Room, Garden {
  :rode_off false
  :given false
  on :unicorn_gone (from, value) { self.set(:rode_off, true)  self.set(:given, value) }
}
kind TopiaryRoom is Room, Garden { }
// The two rooms that hear the carousel whirring.
kind NearCarousel is DarkRoom { }

object garden_north is GardenNorth in underground_caverns_2 {
  grammar {
    name "North End of Garden"
    exit in "into the gazebo" -> gazebo
    exit north "north" -> dark_tunnel
    exit south "south" -> formal_garden
  }
  :id garden_north
  :walls 4
  passage body { This is the northern end of a formal garden. Hedges hide the cavern walls, and if you don't look up, the illusion is of a cloudy day outside. The light comes from a large growth of glowing mosses on the roof of the cave. A break in the hedge is almost overgrown to the north; the dark tunnel you came by is through it. A carefully manicured path leads south. In the center of a rosebed is a small open structure, painted white. It appears to be a gazebo, and a few flagstones lead in to it between the roses; through its railing you can make out a tea table, laid, with things on it.{if self.get(:rode_off) && !self.get(:given)} The hedge on the east side has been pushed through by something that left in a hurry, and there is a hoofprint in the rosebed. The unicorn has not been seen since, nor what hung round its neck.{/if} }
  object unicorn is Unicorn
  // The unicorn's stand-in, unseen while the unicorn is home, so the two
  // never tie for the word; while it is away, "unicorn" and "key" are
  // answered in voice.
  object other_unicorn is AbsentUnicorn
  object other_princess is AbsentPrincess { :order 8  :way inside }
  object gazebo_outside is Gazebo
  object hedge is Hedges
  object roses is RoseBush
  object moss is Moss
  object path is GardenPath
  object break is Scenery {
    grammar { name "break in the hedge"  nouns "break", "gap", "opening"  adjectives "overgrown" }
    passage short { break in the hedge }
    describe { text "The break in the hedge to the north is almost overgrown, and leads back into the dark tunnel, which is not an improvement on the garden." }
  }
}

object gazebo is Room, Garden in underground_caverns_2 {
  grammar {
    name "Gazebo"
    exit out "out to the garden" -> garden_north
    exit north "north" -> garden_north
  }
  :id gazebo
  :walls 4
  :rode_off false
  :given false
  on :unicorn_gone (from, value) { self.set(:rode_off, true)  self.set(:given, value) }
  passage body { This is a gazebo in the midst of a formal garden. It is cool and restful here. A tea table adorns the center of the gazebo.{if self.get(:rode_off) && !self.get(:given)} Somebody has been here and gone, not long ago: the rose on the floor says who, and the hoofprint in the rosebed outside says how, and nothing says that she waited.{/if} }
  object other_unicorn is DistantUnicorn
  object other_princess is AbsentPrincess { :order 9  :last true }
  object gazebo_inside is GazeboInside
  object table is Box {
    grammar { name "tea table"  nouns "table"  adjectives "tea", "small", "round" }
    :open true
    :surface true
    :capacity 100
    :ndesc true
    // Declared contents are never `:entered`, so the count of what is
    // listed plainly is written by hand (friction 31).
    :plain 5
    passage short { tea table }
    passage examined { It is a small round table of white-painted iron, laid for a tea that nobody came to, or that somebody left in a hurry. {self.look_inside} }
    object newspaper is Newspaper
    object mat is PlaceMat
    object teapot is Teapot
    object opener is LetterOpener
    object matchbook is Matchbook
  }
  object roses is RoseBush {
    describe { text "The roses stand round the gazebo in a bed, red and heavy-headed and very thorny, and have come up through the floorboards in one corner to see what is going on inside." }
  }
  object bench is Scenery {
    grammar { name "bench"  nouns "seat"  adjectives "wooden" }
    passage short { bench }
    describe { text "A bench runs round the inside of the railing, white-painted and in need of it again. It is cool and restful, and you could sit on it for a long time, which is possibly what happened to the last person who did." }
  }
}

object formal_garden is Room, Garden in underground_caverns_2 {
  grammar {
    name "Formal Garden"
    exit west "west" -> stream_path
    exit north "north" -> garden_north
    exit south "south" -> topiary
  }
  :id formal_garden
  :walls 4
  passage body { This is the middle part of a formal garden. Hedges hide the cavern walls and a dim illumination comes from mosses far above. The path is of small crushed white stones. It winds among bushes and flower beds from south to north. To the north a small structure can be seen. To the south are peculiarly shaped bushes. There is a small gap in the hedges to the west. }
  object other_unicorn is DistantUnicorn
  object other_princess is AbsentPrincess { :order 7  :way north }
  object hedge is Hedges
  object moss is Moss
  object path is GardenPath
  object beds is FlowerBeds
  object structure is SmallStructure
  object gap is Scenery {
    grammar { name "gap in the hedges"  nouns "gap", "opening"  adjectives "small" }
    passage short { gap in the hedges }
    describe { text "A small gap in the hedges to the west, where the garden gives up and the cave begins again. The path through it is not manicured." }
  }
}

object topiary is TopiaryRoom in underground_caverns_2 {
  grammar {
    name "Topiary"
    exit west "west" -> carousel_room
    exit north "north" -> formal_garden
  }
  :id topiary
  :walls 4
  passage body { This is the southern end of a formal garden. Hedges hide the cavern walls and mosses provide dim illumination. Fantastically shaped hedges and bushes are arrayed with geometric precision. They have not recently been clipped, but you can discern creatures in the shapes of the bushes: There is a dragon, a unicorn, a great serpent, a huge misshapen dog, and several human figures. On the west side of the garden the path leads through a rose arbor into a tunnel. }
  object other_unicorn is HedgeUnicorn
  object hedges is TopiaryHedges
  object animals is TopiaryAnimals
  object dragon is TopiaryDragon
  object serpent is TopiarySerpent
  object dog is TopiaryDog
  object figures is TopiaryFigures
  object moss is Moss
  object roses is RoseBush
  object path is GardenPath
  object arbor is Scenery {
    grammar { name "rose arbor"  nouns "arbor", "tunnel"  adjectives "rose" }
    passage short { rose arbor }
    describe { text "On the west side of the garden the path goes through an arbor of roses, trained over a frame, and the frame over the mouth of a tunnel, so that one goes from flowers into rock without an interval. The roses lean in a little as you look." }
  }
}

object stream_path is NearCarousel, Bridged, ChasmEdge in underground_caverns_2 {
  grammar {
    name "Path Near Stream"
    exit east "east" -> formal_garden
    exit northeast "northeast" -> dark_tunnel
    exit southwest "southwest" -> carousel_room
    exit west "west" -> marble_hall when (self.get(:secret))
    exit down "down" refuse "The ravine is extremely deep. You would never make it."
  }
  :id stream_path
  :walls 2
  // The secret door the princess opens on her way home (SECRET-DOOR).
  :secret false
  on :secret_door { self.set(:secret, true) }
  passage body { The path follows the south edge of a deep ravine and heads northeast. A tunnel heads southwest, narrowing to a rather tight crawl. A faint whirring sound can be heard in that direction, as of something very large going round that will not keep still. On the east is a ruined archway choked with vegetation.{if self.get(:secret)} Behind some rocks to the west, a section of wall stands slid aside, and a passage leads through it into a marble hall.{/if} }
  object other_princess is AbsentPrincess { :order 6  :way east }
  object rocks is Scenery {
    grammar { name "rocks"  nouns "rock", "boulders", "section"  adjectives "some", "loose" }
    passage short { rocks }
    describe { text "{if stream_path.is(NearCarousel)}{if stream_path.get(:secret)}Behind the rocks, a section of the wall has slid aside, marble on the far side of it and a passage going through to the west. It was a wall when you first came by, and a good one.{else}Some rocks against the west side of the path, fallen from above and settled, with the cavern wall behind them. There is nothing behind the rocks but wall, as far as you can tell, and you cannot tell far.{/if}{/if}" }
  }
  object bridge is Bridge {
    describe { text "There is no bridge here; the foot bridge is back the way you came, to the northeast, across the ravine." }
    without as target for cross from Bridge
    as target for cross { do { say "There is no bridge here. The foot bridge is to the northeast." } }
  }
  object chasm is Chasm
  object stream is Stream
  object archway is Archway
  object whirring is WhirringSound
}

object marble_hall is NearCarousel in underground_caverns_2 {
  grammar {
    name "Marble Hall"
    exit east "east" -> stream_path when (self.get(:secret))
    exit east "east" refuse "That's a wall there."
    exit north "north" -> deep_ford
    exit south "south" -> carousel_room
  }
  :id marble_hall
  :walls 5
  :secret false
  on :secret_door { self.set(:secret, true) }
  passage body { This is an arched hall of fine marble. The hall stops abruptly to the north at a ford across a stream, where the marble is cracked and broken. Perhaps a flood or collapse of the cave was responsible. To the south the hall opens into a large room. There is rather annoying whirring sound coming from that room, as of something very large that will not keep still.{if self.get(:secret)} A large section of the east wall has slid away, revealing a passage to the east.{/if} }
  object other_princess is AbsentPrincess { :order 5  :way east }
  object brick is Brick
  object loose_marble is Scenery {
    grammar { name "loose piece of marble"  nouns "piece", "panel", "section"  adjectives "loose" }
    passage short { loose piece of marble }
    describe { text "{if marble_hall.is(NearCarousel)}{if marble_hall.get(:secret)}The piece of marble the princess pressed stands a little proud of the east wall, and the section beside it has slid away into the rock, leaving a passage east. Pressing it again does nothing; it has done its one trick.{else}The east wall is fine marble, veined and polished, and if any piece of it is looser than the rest you cannot find it by looking. That's a wall there.{/if}{/if}" }
    as target for shift { do { say "{if marble_hall.is(NearCarousel)}{if marble_hall.get(:secret)}It has done its one trick; the wall stays open.{else}You press the marble here and there. It is marble, and does not care. If one piece of it is loose, it is waiting for somebody who knows which.{/if}{/if}" } }
  }
  object stream is Stream
  object marble is CrackedMarble
  object ford is Scenery {
    grammar { name "ford"  nouns "crossing"  adjectives "deep" }
    passage short { ford }
    describe { text "The hall stops at the ford to the north, where the stream crosses it; the marble is cracked and broken there, and the water goes over the pieces." }
  }
  object whirring is WhirringSound {
    describe { text "The whirring comes from the large room to the south, steady and mechanical and rather annoying, as of something very large going round and round." }
    without as target for listen from WhirringSound
    as target for listen { do { say "A whirring, rather annoying, from the large room to the south." } }
  }
}

object deep_ford is DarkRoom, Watery, ChasmEdge in underground_caverns_2 {
  grammar {
    name "Deep Ford"
    exit north "north" -> ravine_ledge
    exit up "up" -> ravine_ledge
    exit south "south" -> marble_hall
    exit east "east" refuse "The stream deepens rapidly, and you wisely return before drowning."
    exit west "west" refuse "You notice that the ledge above would be a drier route west."
  }
  :id deep_ford
  :walls 2
  passage body { You are fording the stream at a deep but not impossible spot. The water is very cold. The walls of the ravine rise to east and west. There is a small ledge along the north wall of the ravine. To the south is the entrance to a well-constructed but somewhat ruined hall. }
  object other_princess is AbsentPrincess { :order 4  :way south }
  object water is StreamWater {
    describe { text "The water is very cold, and deep here, up to your knees and pulling at them, and clear enough to see the gravel it is trying to take you down to. It would fill a teapot." }
  }
  object chasm is Chasm
  object stream is Stream
  object ledge is Ledge
  object hall is Scenery {
    grammar { name "ruined hall"  nouns "hall", "entrance"  adjectives "ruined", "well-constructed", "marble" }
    passage short { ruined hall }
    describe { text "To the south, the stream runs in under an arch of marble: the entrance to a hall that was built well and ruined since, by water or by something that did not care for marble." }
  }
  object ravine_walls is Scenery {
    grammar { name "walls of the ravine"  nouns "ravine"  adjectives "steep" }
    passage short { walls of the ravine }
    describe { text "The walls of the ravine rise to the east and the west, steep and wet, and the stream has the whole of the floor between them." }
  }
}
