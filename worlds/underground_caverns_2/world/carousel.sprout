// The Carousel Room, which spins the visitor's sense of direction until
// the robot stops it (CAROUSEL-ROOM-FCN), and Room 8 to its west, with
// the grue repellent. The room's random turn is the visitor's own doing
// (adventurer.sprout): every way out of it leads where it says, and the
// visitor, arriving, turns four times in five to a random one of seven.
// West, while it spins, is always random.
import * as sprout from 'sprout'
import {Thing, Scenery} from 'thing'
import {Room, DarkRoom} from 'room'
import {IronBox, Violin, Repellent} from 'items'
import {listen, read, through, :flip, :zoom} from 'verbs'
import {Adventurer} from 'adventurer'
import {marble_hall, stream_path, topiary} from 'garden'
import {riddle_room} from 'riddle'
import {cool_room} from 'dragon'
import {menhir_room} from 'menhir'
import {cobwebby_corridor} from 'volcano'

kind CarouselRoom is DarkRoom {
  :spinning true
  :zooming false
  // How many times the room has thrown somebody out while spinning: after
  // a few, the room lets on that its passages are not quite alike.
  :spins 0 min 0 max 1000
  on :flip { self.set(:spinning, !self.get(:spinning)) }
  on :zoom (from, value) { self.set(:zooming, value) }
  on :left (item, to) { if (item.is(Adventurer) && self.get(:spinning)) { self.adjust(:spins, 1) } }
}

kind EightPassages is Scenery {
  grammar { name "passages"  nouns "passage", "exits", "exit", "eight", "one"  adjectives "identical", "eight", "climbing", "southeast", "northwest", "southwest", "misty", "cobwebbed" }
  passage short { passages }
  describe { text "Eight passages, one at each point of the compass, and every one of them very nearly like the others: the same height, the same rough arch, the same dark beyond it. Very nearly. The one on the southeast side, if you can keep track of which that is, climbs a little, and a draught comes down it that smells of old brick and older water; the one on the northwest side breathes out a cold, wet mist; the one on the southwest side has cobwebs across it, broken in the middle. Whoever cut them wanted you to have to think." }
  // Taken or entered by name (round 8's P3): the passages are the eight
  // ways out, and the room gives them by compass point and takes them
  // back the same way.
  passage walk_in { The passages are the eight ways out of here, and the room hands them to you by compass point, north round to northwest, and takes them back the same way. Pick a point and walk; which passage you get is the floor's business, while it turns. }
  passage no_take { {self.walk_in} }
  without as target for through from Thing
  as target for through { do { say walk_in } }
}

object carousel_room is CarouselRoom in underground_caverns_2 {
  grammar {
    name "Carousel Room"
    exit north "north" -> marble_hall
    exit northeast "northeast" -> stream_path
    exit east "east" -> topiary
    exit southeast "southeast" -> riddle_room
    exit south "south" -> menhir_room
    exit southwest "southwest" -> cobwebby_corridor
    exit west "west" -> room_8
    exit northwest "northwest" -> cool_room
  }
  :id carousel
  passage body { You are in a large circular room whose high ceiling is lost in gloom. Eight identical passages leave the room.{if self.get(:spinning)}

    A loud whirring sound comes from all around, and you feel sort of disoriented in here.{/if}{if self.get(:spinning) && self.get(:spins) < 2}

    The disorientation is not all in your head. The floor, if you stand still on it a moment, is turning, slowly, and the eight passages go round with it, so that the one you came in by is already somewhere else. They all lead somewhere, every one of them; it is only a question of which, and the only way to settle that is to pick one and walk into it. The one that climbs a little, when it comes round, has a draught down it that smells of old brick and older water, and once, faintly, from up that way, you hear the grinding of a very heavy stone door.{/if}{if self.get(:spins) >= 2}

    You have been thrown out of here enough times now to have noticed that the passages are not quite identical after all: one, on the northwest side, breathes out a cold mist, one, on the southeast side, climbs, and one, on the southwest side, has cobwebs across the mouth of it.{/if} }
  object passages is EightPassages
  object whirring is Scenery {
    grammar { name "whirring sound"  nouns "whirring", "sound", "noise", "whirr"  adjectives "loud" }
    passage short { whirring sound }
    describe { text "{if carousel_room.is(CarouselRoom)}{if carousel_room.get(:spinning)}The whirring comes from all around you, from under the floor, from the walls, from the dark overhead, steady and mechanical, and your sense of which way you came in has gone with it.{else}The whirring has stopped. The silence is almost worse.{/if}{/if}" }
    without as target for listen from Thing
    as target for listen { do { say "{if carousel_room.is(CarouselRoom)}{if carousel_room.get(:spinning)}A loud whirring, from all around, as of a great deal of machinery going round. It makes it hard to think about directions.{else}Nothing. The whirring has stopped, and the room is still.{/if}{/if}" } }
  }
  object box is IronBox {
    :plain 1
    object violin is Violin
  }
}

// Room 8: a place may have eight ways out, and the Carousel's are its
// eight passages, so west leads here spinning or not, and a visitor
// arriving here while it spins is thrown somewhere else, always, as Zork's
// west is (adventurer.sprout).
kind RoomEight is DarkRoom { }
object room_8 is RoomEight in underground_caverns_2 {
  grammar {
    name "Room 8"
    exit east "east" -> carousel_room
  }
  :id room_8
  :walls 8
  passage body { This is a small chamber carved out of the rock at the end of a short crawl. On the wall is crudely chiseled the number "8". }
  object repellent is Repellent
  object number is Scenery {
    grammar { name "number"  nouns "8", "eight", "numeral", "chiseling"  adjectives "chiseled", "crude" }
    passage short { number }
    describe { text "The number \"8\" is chiseled into the wall, crudely, by somebody who was either counting rooms or had run out of other ideas. There is no 7 and no 9." }
    without as target for read from Thing
    as target for read { do { say "It says \"8\". It is hard to misread." } }
  }
}
