// Rooms. A room reads as Zork's do: its name, its description, then what
// is in it, each in its own paragraph. A room worth points (the Top of
// Well) pays them to whoever first walks in. Every room keeps which room
// it is (`:id`), so that what stands in it can say so to something that
// cannot see it: the Wizard's clock, the bucket.
//
// A dark room is lit only while it sees a lit lamp, on its floor or in
// somebody's hands; until then a visitor in it can name only what they
// carry, and reads the world's `dark` line, the grue's warning, for its
// description. What it keeps besides, `:alight`, is for the grue: a
// handler cannot ask a place whether it is lit, so the room counts its
// own lamps and tells each visitor in it whether it would be lit without
// them.
import * as sprout from 'sprout'
import {Thing, Scenery} from 'thing'
import {Light} from 'lamp'
import {Box} from 'box'
import {Adventurer} from 'adventurer'
import {read, listen, search, look_in, look_under, shift, climb_up, climb_down, take, through, Dest, Spell, :scored, :relight, :room_lit, :wall_look, :snuffed, :munge, :room_sealed, :brief_hint} from 'verbs'

kind Room is sprout.Place {
  grammar { article none }

  :value 0 min 0 max 100
  :glow 0 min 0 max 2
  :id Dest default nowhere
  // Which walls these are, for the wall to describe.
  :walls 0 min 0 max 9
  // Zork's RMUNGBIT: the room is not to be entered again, and its exits
  // say why (the closet full of gas, a room blown up by a cake).
  :munged false

  object wall is Wall
  object grue is Grue
  object tunnel is Tunnel
  object floor is Floor
  object ceiling is Ceiling
  object mirage is Illusion

  remembers { :visits 0 min 0 max 2 }
  :visited false

  passage title default { {self} }
  passage body default { {if false}.{/if} }
  // Zork's PRINT-CONT: first what has a first description and has not been
  // moved, then everything else.
  passage objects {
    {for t: Thing in self}{if !t.get(:ndesc) && t.get(:has_fdesc) && !t.get(:touched)}

    {t.fdesc}{t.inside_lines}{/if}{/for}{for t: Thing in self}{if t.get(:ndesc) || !t.get(:has_fdesc) || t.get(:touched)}{if !t.get(:ndesc)}

    {t.ldesc}{/if}{t.inside_lines}{/if}{/for}
  }
  passage full {
    {self.title}

    {self.body}

    {self.objects}
  }
  passage brief default {
    {self.title}

    {self.objects}
  }
  // The room seen from the bucket, as Zork's DESCRIBE-ROOM shows a room
  // from a vehicle.
  passage bucket_view {
    {self.title}, in the wooden bucket

    {self.body}

    {self.objects}
  }

  // Zork's DESCRIBE-ROOM: the room's name always; its long description on
  // `look`, in VERBOSE, or the first time in; what is in it unless
  // SUPERBRIEF. Arriving is the only time a visitor's mode is asked.
  describe { text described }
  passage described {
    {if seen == :arrival && actor.is(Adventurer) && actor.get(:mode) == :superbrief}{self.title}{else if seen == :arrival && actor.is(Adventurer) && actor.get(:mode) == :brief && actor.recall(:visits) > 1}{self.brief}{else}{self.full}{/if}
  }

  // A room answers to the words of its name ("Tea Room" to `tea`), but
  // only where nothing in it does; then it is as if nothing were there.
  as target for any { permit { refuse "You can't see any such thing." } }
  as tool for any { permit { refuse "You can't see any such thing." } }

  // Blown up by a cake (ICEBOOM's MUNG-ROOM): no way back in, and the
  // rooms whose ways lead here are told.
  on :munge { self.set(:munged, true)  broadcast :room_sealed with self.get(:id) }

  on :entered (item, from) {
    if (item.is(Adventurer)) {
      send wall :wall_look with self.get(:walls)
      // A room only passed through (the Carousel's random turn, the Low
      // Room's) is not visited and pays nothing.
      if (!item.get(:spun)) {
        self.set(:visited, true)
        let seen_by = !self.is(DarkRoom) || item.get(:light) > 0
        // The first room seen again by its name alone: one word, once,
        // about LOOK and VERBOSE.
        if (item.recall(:visits) == 1 && seen_by && item.get(:mode) == :brief) { send item :brief_hint }
        if (item.recall(:visits) < 2 && seen_by) { item.adjust(:visits, 1) }
        if (self.is(DarkRoom) && item.recall(:visits) < 2 && !seen_by) {
          if (self.get(:alight)) { item.adjust(:visits, 1) }
        }
        if (self.get(:value) > 0) {
          send item :scored with self.get(:value)
          self.set(:value, 0)
        }
      }
    }
  }
}

kind DarkRoom is Room {
  grammar { lit (self.get(:daylight) || self.sees(sprout.LightSource, :lit)) }

  :daylight false
  :floor_lit false
  :bearers 0 min 0 max 50
  :alight false

  on :entered (item, from) { send self :relight }
  on :left (item, to)      { send self :relight }
  on :snuffed              { send self :relight }

  on :relight {
    self.set(:floor_lit, self.get(:daylight))
    self.set(:bearers, 0)
    each l: Light in self { if (l.get(:lit)) { self.set(:floor_lit, true) } }
    each b: Box in self {
      if (b.get(:open) || b.get(:transparent)) { each l: Light in b { if (l.get(:lit)) { self.set(:floor_lit, true) } } }
    }
    each a: Adventurer in self { if (a.get(:light) > 0) { self.adjust(:bearers, 1) } }
    self.set(:alight, self.get(:floor_lit) || self.get(:bearers) > 0)
    each a: Adventurer in self {
      if (a.get(:light) > 0) { send a :room_lit with self.get(:floor_lit) || self.get(:bearers) > 1 }
      else { send a :room_lit with self.get(:alight) }
    }
  }
}

// The garden's rooms, where the unicorn comes and goes and the topiary
// creeps (I-GARDEN).
kind Garden { }
// Where a bridge is (Zork's BRIDGE in LOCAL-GLOBALS): the Fall spell is
// fatal here.
kind Bridged { }
// Where a chasm is: a down that is a long way down.
kind ChasmEdge { }
// Where the visitor is small and the furniture is huge (NONLANDBIT): the
// Posts Room and the Pool Room.
kind Wonderland { }
// The Tea Room, and the Posts Room, as the cakes know them.
kind TeaRoomLike { }
kind PostsLike { }
// Where a cake keeps: the Tea Room, the Posts Room, the Pool Room, the
// Machine Room, the Low Room, the Dingy Closet, the Top of Well and the
// cage (CAKE-CRUMBLE's list).
kind CakeSafe { }
// Rooms that are no place to stand (NONLANDBIT): the Top of Well and the
// Circular Room, where the Float spell ends badly, and the Wizard floats.
kind Airy { }
// Where a fresh-water stream can be reached (GLOBAL-WATER).
kind Watery { }

// Zork's EAST-WALL, WEST-WALL and the rest, GLOBAL-OBJECTS: the
// surrounding wall, in every room. Sprout has no object that is everywhere
// at once, so every room holds its own, and tells it which walls these
// are as a visitor comes in.
kind Wall is Scenery {
  grammar { name "wall"  nouns "walls"  adjectives "east", "west", "north", "south", "eastern", "western", "cavern", "surrounding" }
  passage short { wall }
  :look 0 min 0 max 9
  on :wall_look (from, value) { self.set(:look, value) }
  passage plain { The walls are solid rock, plain and entirely uninterested in you. }
  passage barrow { The walls of the barrow are great flat stones set on end, older than anything you have ever seen, and fitted without mortar by someone who did not expect to be back. }
  passage ravine { The walls of the ravine are steep and crumbly, the sort of rock that comes away in the hand and takes the hand with it. }
  passage limestone { The walls are limestone, wet and fluted, and glow very faintly where the moss has got a grip. }
  passage hedged { The hedges hide the cavern walls. Where they thin, there is grey rock behind the green, which rather spoils the illusion. }
  passage marble { The walls are fine marble, veined and polished, cracked here and there by whatever ruined the hall. }
  passage brick { The walls are brick and mortar, damp and dark, curving away above you into nothing your lamp can reach. }
  passage riddle_wall { The walls are bare on all sides, which is the point of the room: there is nothing to look at but the riddle. }
  passage carved { The walls are rough rock. Somebody has gone to the trouble of carving a number into one of them. }
  passage chiselled { The walls of the closet are rough stone, and somebody with time on their hands has chiselled a notice into one of them. }
  describe {
    if (self.get(:look) == 1) { text barrow }
    else if (self.get(:look) == 2) { text ravine }
    else if (self.get(:look) == 3) { text limestone }
    else if (self.get(:look) == 4) { text hedged }
    else if (self.get(:look) == 5) { text marble }
    else if (self.get(:look) == 6) { text brick }
    else if (self.get(:look) == 7) { text riddle_wall }
    else if (self.get(:look) == 8) { text carved }
    else if (self.get(:look) == 9) { text chiselled }
    else { text plain }
  }
}

// Zork's TUNNEL, another GLOBAL-OBJECT: the passage, the tunnel, the
// crawlway, in every room.
kind Tunnel is Scenery {
  grammar { name "passage"  nouns "tunnel", "crawlway", "passageway", "path", "corridor"  adjectives "dark", "smoky", "narrow", "wide" }
  passage short { passage }
  describe { text "The passage is cut through the rock, and goes where it goes. The ways out of here are described above, and you may take any of them." }
  without as target for through from Thing
  as target for through { do { say "Use compass directions for movement, and say which way." } }
}

kind Floor is Scenery {
  grammar { name "floor"  nouns "ground"  adjectives "stone", "rock" }
  passage short { floor }
  describe { text "The floor is the sort of thing you stand on. You are standing on it." }
  without as target for search from Thing
  as target for search { do { say "Everything that is on the floor is listed, in the room's description, and the rest is floor." } }
  without as target for look_under from Thing
  as target for look_under { do { say "There is nothing under the floor but more floor, and then, eventually, lava." } }
}
kind Ceiling is Scenery {
  grammar { name "ceiling"  nouns "roof"  adjectives "high", "low", "cavern" }
  passage short { ceiling }
  describe { text "The ceiling is some way above you, where ceilings generally are. It is not the most interesting thing in the room." }
}

// What the Fantasize spell puts in a room that is not there (DESCRIBE-
// OBJECTS): a basilisk, a pile of jewels, a gold ingot, a bulging chest, a
// convention of wizards, a copy of ZORK I. Zork never declared them, so
// "take jewels" was no sentence at all; here every room keeps one, as it
// keeps a grue, so that reaching for what the Wizard's word put there is
// answered in the narrator's voice and not the parser's (friction 35).
kind Illusion is Scenery {
  grammar { name "basilisk"  nouns "jewels", "ingot", "chest", "convention", "wizards", "copy", "book"  adjectives "bulging", "yellow", "gold", "convention", "pile" }
  passage short { basilisk }
  passage gone {
    {if actor.is(Adventurer) && actor.get(:spell) == :fantasize}Your hand closes on nothing, and your eye on less. It was never there: the Wizard's word put it in the room, and the room, having no say in the matter, let it, and has the grace to look embarrassed about it now.{else}There is nothing of the kind here. If there was a moment ago, the Wizard had a word in it, and the word has worn off.{/if}
  }
  as target for any { permit { refuse gone } }
  as tool for any { permit { refuse gone } }
}

// Zork's GRUE: never here, always nearby.
kind Grue is Scenery {
  grammar { name "lurking grue"  nouns "grue", "grues"  adjectives "lurking", "sinister", "hungry", "silent" }
  passage short { lurking grue }
  passage absent { There is no grue here, but I'm sure there is at least one lurking in the darkness nearby. I wouldn't let my light go out if I were you! }
  describe { text "The grue is a sinister, lurking presence in the dark places of the earth. Its favorite diet is adventurers, but its insatiable appetite is tempered by its fear of light. No grue has ever been seen by the light of day, and few have survived its fearsome jaws to tell the tale." }
  without as target for listen from Thing
  as target for listen { do { say "It makes no sound but is always lurking in the darkness nearby." } }
  without as target for search from Thing
  as target for search { do { say absent } }
  without as target for look_in from Thing
  as target for look_in { do { say absent } }
  without as target for look_under from Thing
  as target for look_under { do { say absent } }
}
