// The well: the Circular Room at its bottom, the Top of Well, and the
// wooden bucket between them, which rises when there is fresh water in it
// and comes down when there is not (BUCKET-FCN, I-BUCKET, PASS-THE-BUCKET,
// WELL-FCN, WISH-FCN, the etchings); and the Tea Room east of the top,
// set for the mad (ALICE-TABLE, EATME-FCN, CAKE-FCN, ALICE-HOLE).
//
// The bucket is a place (`sprout.Place`) that also stands on the floor:
// whoever boards it is in it, and goes where it goes. It cannot name the
// room it stands in, so it keeps which end of the well it is at (`:at`),
// and its way out leads to whichever end that is.
import * as sprout from 'sprout'
import {Thing, Scenery, Portable, Vessel, Wishing, Door} from 'thing'
import {Box} from 'box'
import {Room, DarkRoom, Airy, CakeSafe, TeaRoomLike} from 'room'
import {Light} from 'lamp'
import {Water, EatMeCake, BlueCake, OrangeCake, RedCake} from 'items'
import {Adventurer} from 'adventurer'
import {pearl_room} from 'riddle'
import {low_room} from 'machine'
import {read, look_in, look_under, climb_up, climb_down, kick, burn, board, disembark, through, wish, put, throw, look_down, knock, pour_in, Dest, :room_sealed, :open_gate, :gate_open, :close_gate, :die, :consume} from 'verbs'

enum Errand { idle, rise, descend, dry }

kind Bucket is sprout.Place, Box, Vessel {
  :open true
  :capacity 100
  :size 100
  :at Dest default well_bottom
  :riders 0 min 0 max 20
  :errand Errand default idle
  :daylight false
  :seeing false
  grammar {
    name "wooden bucket"
    nouns "bucket", "pail"
    adjectives "wooden", "large"
    lit (self.sees(sprout.LightSource, :lit))
    exit out "out" -> well_top when (self.get(:at) == :well_top)
    exit out "out" -> well_bottom
    exit east "east" -> tea_room when (self.get(:at) == :well_top)
    exit west "west" -> pearl_room when (self.get(:at) == :well_bottom)
    exit up "up" refuse "You'd have to get the bucket to go up, and it goes up for water, not for you."
    exit down "down" refuse "It's a long way down!" when (self.get(:at) == :well_top)
    exit down "down" refuse "You are at the bottom of the well already, in a bucket."
  }
  passage short { wooden bucket }
  passage ldesc { There is a wooden bucket here, 3 feet in diameter and 3 feet high. }
  passage inside_view {{if self.get(:at) == :well_top}{if well_top.is(WellTop)}{well_top.bucket_view}{/if}{else}{if well_bottom.is(WellBottom)}{well_bottom.bucket_view}{/if}{/if}}
  passage examined { It is a wooden bucket, 3 feet across and 3 feet high, bound with iron hoops, and hung on a rope that goes up into the dark further than your light can follow. It is big enough to sit in, and somebody, from the wear on the rim, has.

    {self.look_inside} }
  describe {
    if (self.holds(actor)) { text inside_view } else { text examined }
  }
  passage no_take { The bucket is far too large to carry, and it is tied to the well. }

  // What is in the bucket is reached from in it (BUCKET-CONT).
  release (item, to) {
    if (mover.is(Adventurer) && !self.holds(mover) && item.is(Thing)) { refuse "You'll need to get in the bucket to reach it." }
  }

  without as container for pour_in from Thing
  as container for pour_in { do { } }
  without as target for kick from Thing
  as target for kick {
    do {
      say "If you insist."
      if (actor.is(Adventurer)) { send actor :die }
    }
  }
  without as target for burn from Thing
  as target for burn { do { say "The bucket is fireproof, and won't burn." } }
  without as target for climb_up from Thing
  without as target for climb_down from Thing
  as target for board { do { } }
  as target for disembark { do { } }
  without as target for through from Thing
  as target for through { do { } }

  on :entered (item, from) {
    if (item.is(Adventurer)) {
      self.adjust(:riders, 1)
      self.set(:ndesc, true)
    } else if (item.is(Water)) {
      if (!item.get(:salty) && self.get(:at) == :well_bottom) {
        if (self.get(:riders) == 0) { tell outside "The bucket swiftly rises up, and is gone." }
        self.set(:errand, :rise)
        send underground_caverns_2 :open_gate
      }
    }
  }
  on :left (item, to) {
    if (item.is(Adventurer) && to != self) {
      self.adjust(:riders, -1)
      self.set(:ndesc, self.get(:riders) > 0)
    } else if (item.is(Water)) {
      if (self.get(:at) == :well_top && self.count(Water) == 0) {
        cancel wakes
        self.set(:errand, :descend)
        send underground_caverns_2 :open_gate
      }
    }
  }
  // Drunk, or spilled, the water is gone without leaving: the bucket
  // comes down at the end of the move (BUCKET-FCN's M-END).
  after command {
    if (self.get(:at) == :well_top && self.count(Water) == 0 && self.get(:errand) == :idle) {
      cancel wakes
      self.set(:errand, :descend)
      send underground_caverns_2 :open_gate
    }
  }
  // The water evaporates in a hundred moves (I-BUCKET), and the bucket
  // comes down.
  on :woke (elapsed) {
    if (self.get(:at) == :well_top && self.count(Water) > 0) {
      each w: Water in self { send w :consume }
      self.set(:errand, :dry)
      send underground_caverns_2 :open_gate
    }
  }
  on :gate_open {
    let e = self.get(:errand)
    if (e == :rise) { move self to well_top }
    else if (e == :descend || e == :dry) { move self to well_bottom }
    send underground_caverns_2 :close_gate
  }
  on :moved (from, to) {
    let e = self.get(:errand)
    self.set(:errand, :idle)
    if (to.is(Room)) { self.set(:at, to.get(:id)) }
    if (e == :rise) {
      cancel wakes
      wake in 50 minutes
      tell inside "The bucket rises and comes to a stop."
    } else if (e == :descend) {
      tell inside "The bucket descends and comes to a stop."
    } else if (e == :dry) {
      tell inside "The last of the water evaporates, and the bucket descends."
    }
    if (e != :idle) {
      self.set(:seeing, false)
      each l: Light in self { if (l.get(:lit)) { self.set(:seeing, true) } }
      each r: Adventurer in self { if (r.get(:light) > 0) { self.set(:seeing, true) } }
      if (self.get(:riders) > 0) {
        if (!self.get(:seeing)) { tell inside "It is pitch black. You are likely to be eaten by a grue." }
        else { tell inside "{self.inside_view}" }
      }
    }
  }
}

// The well itself, from the bottom and from the top (WELL, WISH).
kind WellBottomWall is Scenery, Wishing {
  grammar { name "well"  nouns "shaft", "brick", "mortar", "bricks"  adjectives "magic", "brick" }
  passage short { well }
  describe { text "You are at the bottom of it. The walls are brick and mortar, damp, and go up into the dark in a circle for a long way; the roof of the well is not visible, and may not exist. There are etchings on the walls." }
  without as target for climb_up from Thing
  as target for climb_up { do { say "You can't climb the well." } }
  without as target for climb_down from Thing
  as target for climb_down { do { say "You can't climb the well." } }
  without as target for look_in from Thing
  as target for look_in { do { say "You are in it. Looking up, the brick goes up until the dark takes it, and then there is only dark." } }
  as target for wish {
    do {
      say "No one is listening."
    }
  }
}
kind WellTopMouth is Box, Wishing {
  grammar { name "well"  nouns "shaft", "mouth", "hole"  adjectives "magic", "brick" }
  :ndesc true
  :open true
  :capacity 10000
  passage short { well }
  describe { text "The mouth of the well is a ring of brick at the top of the shaft, worn smooth at one side where the bucket rope runs over it. Looking down, there is a great deal of dark and, at the bottom of it, nothing you can make out." }
  without as target for climb_up from Thing
  as target for climb_up { do { say "You can't climb the well." } }
  without as target for climb_down from Thing
  as target for climb_down { do { say "You can't climb the well." } }
  without as target for look_in from Thing
  as target for look_in { do { say "It's a long way down, and dark all the way. If there is anything at the bottom, it is keeping quiet about it." } }
  as target for wish { do { say "No one is listening." } }
  // Something thrown or dropped down it lands at the bottom (WELL-FCN).
  on :entered (item, from) {
    if (item.is(Thing)) {
      tell "The {item.short} is now sitting at the bottom of the well."
      self.set(:sending, true)
      send underground_caverns_2 :open_gate
    }
  }
  :sending false
  on :gate_open {
    if (self.get(:sending)) {
      self.set(:sending, false)
      each t: Thing in self { move t to well_bottom }
    }
    send underground_caverns_2 :close_gate
  }
}

kind TopEtchings is Scenery {
  grammar { name "wall with etchings"  nouns "etchings", "etching", "writing"  adjectives "etched" }
  passage short { wall with etchings }
  passage words {
    The letters are cut in a ring, and read round from the top: o b o, then r and z, then f M A G I C z, then c W E L L y, then o and n, then m p a. Read across the middle, they say MAGIC WELL; read round the rim they spell frobozz magic well company.
  }
  describe { text words }
  without as target for read from Thing
  as target for read { do { say words } }
}
kind BottomEtchings is TopEtchings {
  passage words {
    The letters are cut in a ring, and most of the ring has crumbled with the mortar. What is left reads: o b o at the top, A G I across the middle with E and L beneath, and m p a at the bottom. The rest has gone the way of the brickwork.
  }
}

object well_bottom is WellBottom in underground_caverns_2 {
  grammar {
    name "Circular Room"
    exit west "west" -> pearl_room
    exit up "up" refuse "The walls cannot be climbed."
  }
  :id well_bottom
  :walls 6
  passage body { This is a damp circular room, whose walls are made of brick and mortar. The roof of this room is not visible, but there appear to be some etchings on the walls. There is a passageway to the west. }
  object bucket is Bucket
  object etchings is BottomEtchings
  object well is WellBottomWall
  object rope is Scenery {
    grammar { name "rope"  nouns "line", "cable"  adjectives "bucket" }
    passage short { rope }
    describe { text "A rope runs from the handle of the bucket up into the dark, where something at the top of the well is presumably holding the other end. It is taut, and not the kind of rope that goes anywhere when pulled." }
  }
}

object well_top is WellTop in underground_caverns_2 {
  grammar {
    name "Top of Well"
    exit east "east" -> tea_room
    exit down "down" refuse "It's a long way down!"
  }
  :id well_top
  :value 10
  :walls 6
  passage body { You are at the top of the well. Well done. There are etchings on the side of the well. There is a small crack across the floor at the entrance to a room on the east, but it can be crossed easily. }
  object etchings is TopEtchings
  object well is WellTopMouth
  object crack is Scenery {
    grammar { name "crack"  nouns "fissure"  adjectives "small" }
    passage short { crack }
    describe { text "It is a small crack (as advertised) with no redeeming value." }
    without as target for look_in from Thing
    as target for look_in { do { say "You peer into the crack. It is small, and dark, and has nothing in it, which is more than can be said for most cracks in this place." } }
  }
}

kind TeaRoom is Room, CakeSafe, TeaRoomLike { }
kind WellTop is DarkRoom, Airy, CakeSafe { }
kind WellBottom is DarkRoom, Airy { }

object tea_room is TeaRoom in underground_caverns_2 {
  grammar {
    name "Tea Room"
    exit east "east" refuse "Only a mouse could get in there."
    exit west "west" -> well_top
    exit northwest "northwest" -> low_room
  }
  :id tea_room
  :posts_sealed false
  on :room_sealed (from, value) { if (value == :posts) { self.set(:posts_sealed, true) } }
  passage body { This is a small room containing a large oblong table, no doubt set for afternoon tea. It is clear from the objects on the table that the users were indeed mad. In the eastern corner of the room is a small hole (no more than four inches high). There are passageways leading away to the west and the northwest. }
  object table is Box {
    grammar { name "large oblong table"  nouns "table"  adjectives "large", "oblong", "tea" }
    :open true
    :surface true
    :capacity 50
    :ndesc true
    passage short { large oblong table }
    passage examined { It is a large oblong table, laid for a tea that was a great deal madder than most teas are: the places are set with cakes and nothing else, no cups, no pot, no chairs. {self.look_inside} }
    object eat_me is EatMeCake
    object blue is BlueCake
    object orange is OrangeCake
    object red is RedCake
  }
  object hole is Scenery, Door {
    grammar { name "hole"  nouns "mousehole"  adjectives "small", "tiny" }
    passage short { hole }
    describe { text "The hole is very small. You could never enter it." }
    without as target for look_in from Thing
    as target for look_in { do { say "You can't see what's beyond the hole from here." } }
    without as target for through from Thing
    as target for through { do { say "Only a mouse could get in there." } }
    without as target for knock from Door
    as target for knock { do { say "You knock beside the hole. Nothing comes out, which is the best you could have hoped for." } }
  }
}
