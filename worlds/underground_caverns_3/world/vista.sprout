// The Scenic Vista (FAR-SHORE, VIEW-ROOM, VIEWING-TABLE, VIEW-INDICATOR,
// TORCH): the western shore of the lake, the small chamber south of it
// with the table that shows a far place and sends whoever touches it
// there for three moves, the indicator that cycles through the four views
// every four moves, and the torch on the wall; and the four places the
// table shows: the Timber Room and the mine rooms within three moves of
// it (Zork I), Room 8 and the grue repellent (Zork II), the Damp Passage
// (engravings.sprout), and the Sacrificial Altar (Zork IV), which kills.
//
// The indicator's clock is the world's (I-VIEW-CHANGE runs from the
// game's first move, whoever is where); the snap back is the visitor's.
import * as sprout from 'sprout'
import {Thing, Scenery, Portable, Fixed, Touchable, Readable, Searchable, Concealing, Diggable} from 'thing'
import {Room, DarkRoom} from 'room'
import {Adventurer} from 'adventurer'
import {Lake} from 'lake'
import {Stairs} from 'way_in'
import {Torch} from 'lamp'
import {Repellent} from 'items'
import {rub, read, look_in, look_under, search, shift, climb_up, climb_down, through, smell, listen, dig, cross, :table_touched, :altar_death, :view_changed} from 'verbs'

// The viewing table (VIEWING-TABLE, VIEWING-TABLE-F): touched, it sends
// you where it is showing.
kind ViewingTable is Scenery, Touchable, Concealing, Searchable {
  grammar { name "viewing table"  nouns "table", "surface", "image", "picture"  adjectives "viewing", "pale", "featureless", "angled" }
  passage short { viewing table }
  passage image {
    {if underground_caverns_3.get(:active_view) == 1}You see a passage cluttered with broken timbers. An extremely narrow opening can be seen at the end of the room.{else if underground_caverns_3.get(:active_view) == 2}You see a tiny room with rough walls. Chiseled crudely on one wall is the number "8". The only apparent exit seems to be a blur.{else if underground_caverns_3.get(:active_view) == 3}You see a wide room with two nearly identical passages leading east and northeast. A wide channel descends steeply into the room and seems to be blocked by rubble.{else}You see the interior of a huge temple rudely constructed of basalt blocks. Flickering torches cast a sallow illumination over an altar still wet with the blood of human sacrifice, its velvet covers stained and encrusted with gore.{/if}
  }
  describe {
    text "The surface is pale and featureless, but slowly, an image takes shape!"
    text image
    text "The image slowly fades."
  }
  as target for look_in {
    do {
      say "The surface is pale and featureless, but slowly, an image takes shape!"
      say image
      say "The image slowly fades."
    }
  }
  as target for search {
    do {
      say "The surface is pale and featureless, but slowly, an image takes shape!"
      say image
      say "The image slowly fades."
    }
  }
  as target for rub {
    do {
      say "You touch the table and are instantly transported to another place!"
      if (actor.is(Adventurer)) { send actor :table_touched }
    }
  }
  as target for look_under { do { say "The table is mounted on the wall, and under it is the wall, which is rock, and not scenic either." } }
  as target for shift { do { say "The table is mounted to the wall, and does not move; what moves is on it." } }
  passage no_take { It is mounted on the wall, and it is the wall's. }
}

// The indicator above the table (VIEW-INDICATOR, VIEW-INDICATOR-F).
kind Indicator is Scenery, Readable {
  grammar { name "indicator"  nouns "dial", "numeral", "number", "reading"  adjectives "roman" }
  passage short { indicator }
  passage roman { {if underground_caverns_3.get(:active_view) == 1}I{else if underground_caverns_3.get(:active_view) == 2}II{else if underground_caverns_3.get(:active_view) == 3}III{else}IV{/if} }
  describe { text "The indicator reads \"{self.roman}\"." }
  as target for read { do { say "The indicator reads \"{self.roman}\"." } }
  as target for shift { do { say "The indicator changes when it changes, and not when it is pushed; it has a clock of its own, and the clock is not yours." } }
  passage no_take { It is part of the table, and the table is part of the wall. }
}

kind FarShore is Room { }
kind VistaRoom is Room { }
kind MineRoom is DarkRoom { }
kind TimberRoom is MineRoom { }
kind Altar is Room { }

object far_shore is FarShore in underground_caverns_3 {
  grammar {
    name "Western Shore"
    exit east "east" refuse "If you want to enter the lake, you should say so."
    exit south "south" -> scenic_vista
  }
  :walls 6
  passage body { You are on the western shore of the lake. The ground here is quite hard, but a few sickly reeds manage to grow near the water's edge. The only path leads into the rock to the south. }
  object reeds is Scenery {
    grammar { name "reeds"  nouns "reed", "rushes", "plants"  adjectives "sickly", "few", "thin" }
    passage short { reeds }
    describe { text "A few sickly reeds, grey-green and thin, growing at the water's edge where the hard ground gives up a little. They are not thriving. Nothing on this lake is." }
    passage no_take { They come away in your hand, limp and wet, and you let them go; they were not much to look at and they are less to carry. }
    as target for smell { do { say "They smell of the lake, which is to say of cold." } }
  }
  object shore is Scenery, Diggable {
    grammar { name "shore"  nouns "beach", "edge", "bank", "ground"  adjectives "western", "west", "hard" }
    passage short { shore }
    describe { text "Hard ground, the western shore of the lake, with the water very still against it and the reeds at the edge. There is no sand to speak of, and nothing has been left here by anybody." }
    as target for dig { do { say "There's nothing there." } }
  }
  object path is Scenery {
    grammar { name "path"  nouns "way", "trail"  adjectives "only", "south" }
    passage short { path }
    describe { text "The only path leads south into the rock, cut square, and lit from somewhere beyond." }
    as target for through { do { say "The path leads south; say so." } }
  }
}

object scenic_vista is VistaRoom in underground_caverns_3 {
  grammar {
    name "Scenic Vista"
    exit north "north" -> far_shore
  }
  :walls 15
  passage body { You are in a small chamber carved in the rock, with the sole exit to the north. Mounted on one wall is a table labelled "Scenic Vista," whose featureless surface is angled toward you. One might believe that the table was used to indicate points of interest in the view from this spot, like those found in many parks. On the other hand, your surroundings are far from spacious and by no stretch of the imagination could this spot be considered scenic. An indicator above the table reads "{indicator.roman}". }
  object table is ViewingTable
  object indicator is Indicator
  object torch is Torch
  object sign is Scenery, Readable {
    grammar { name "label"  nouns "sign", "lettering", "words"  adjectives "scenic", "vista" }
    passage short { label }
    describe { text "A label on the table, in the Empire's best municipal lettering: \"Scenic Vista.\" Whoever put it there had a sense of humour, or had never stood here." }
    as target for read { do { say "\"Scenic Vista.\"" } }
  }
  object chamber is Scenery {
    grammar { name "chamber"  nouns "rock", "walls"  adjectives "small", "carved" }
    passage short { chamber }
    describe { text "A small chamber, carved square out of the rock and lit by the torch, with the table on one wall and nothing on the others. It is not a place anybody would come to for the view; it is a place somebody came to for a view of somewhere else." }
  }
  // The indicator changes (I-VIEW-CHANGE), and whoever is here sees it.
  on :view_changed { tell "The indicator above the table flickers briefly, then changes to \"{indicator.roman}\"." }
}

// Zork I: the Timber Room and what is within three moves of it.
object timber_room is TimberRoom in underground_caverns_3 {
  grammar {
    name "Timber Room"
    exit east "east" -> ladder_bottom
    exit west "west" -> drafty_room
  }
  :walls 2
  passage body { This is a long and narrow passage, which is cluttered with broken timbers. A wide passage comes from the east and turns at the west end of the room into a very narrow passageway. From the west comes a strong draft. }
  object timbers is Portable {
    grammar { name "broken timber"  nouns "timbers", "timber", "pile", "wood", "beams"  adjectives "broken", "wooden" }
    :size 50
    passage short { broken timber }
    passage indef { A broken timber }
    passage a_short { a broken timber }
    passage ldesc { There is a pile of broken timbers here. }
    describe { text "Broken timbers, pit-props and beams from when this was a mine somebody meant to go on working, splintered and heaped and in the way. You could carry one. There is no reason on earth to." }
  }
  object draft is Scenery {
    grammar { name "draft"  nouns "draught", "wind", "air"  adjectives "strong", "west" }
    passage short { draft }
    describe { text "A strong draft comes from the narrow passageway to the west, steady and cold, as though something beyond it were breathing in." }
    passage no_take { It is wind. }
  }
  object narrow_passage is Scenery {
    grammar { name "narrow passageway"  nouns "passageway", "opening", "squeeze"  adjectives "narrow", "extremely", "very", "west" }
    passage short { narrow passageway }
    describe { text "At the west end of the room the passage narrows to a passageway you could get through with nothing in your hands and nothing much on your mind. The draft comes out of it." }
    as target for through { do { say "The passageway is to the west; say so, and bring nothing bulky." } }
  }
}

object ladder_bottom is MineRoom in underground_caverns_3 {
  grammar {
    name "Ladder Bottom"
    exit south "south" -> mine_dead_end
    exit west "west" -> timber_room
    exit up "up" -> ladder_top
  }
  :walls 2
  passage body { This is a rather wide room. On one side is the bottom of a narrow wooden ladder. To the west and the south are passages leaving the room. }
  object ladder is Scenery {
    grammar { name "wooden ladder"  nouns "ladder", "rungs"  adjectives "wooden", "rickety", "narrow" }
    passage short { wooden ladder }
    describe { text "A narrow wooden ladder, rickety and old, going up into the dark. It might be safe to climb. It might not." }
    as target for climb_up { do { say "The ladder goes up; say so." } }
    as target for climb_down { do { say "You are at the bottom of it." } }
  }
}

object ladder_top is MineRoom in underground_caverns_3 {
  grammar {
    name "Ladder Top"
    exit down "down" -> ladder_bottom
    exit up "up" refuse "The staircase goes up into another adventure entirely, one you finished some time ago, and the table that brought you here will want you back before you reach the top. You come back down."
  }
  :walls 2
  passage body { This is a very small room. In the corner is a rickety wooden ladder, leading downward. It might be safe to descend. There is also a staircase leading upward. }
  object ladder is Scenery {
    grammar { name "wooden ladder"  nouns "ladder", "rungs"  adjectives "wooden", "rickety", "narrow" }
    passage short { wooden ladder }
    describe { text "A rickety wooden ladder, leading downward into the dark. It might be safe to descend. It was, the last time, more or less." }
    as target for climb_down { do { say "The ladder goes down; say so." } }
    as target for climb_up { do { say "You are at the top of it." } }
  }
  object staircase is Stairs {
    describe { text "A staircase leading upward, into a part of the Empire you have been through already, a long time ago, in another game. It does not go anywhere you need to go now." }
    as target for climb_up { do { say "The staircase goes up; say so, though it will not take you far." } }
  }
}

object mine_dead_end is MineRoom in underground_caverns_3 {
  grammar {
    name "Dead End"
    exit north "north" -> ladder_bottom
  }
  :walls 2
  passage body {
    You have come to a dead end in the mine.

    There is a small pile of coal here.
  }
  object coal is Scenery, Searchable {
    grammar { name "pile of coal"  nouns "coal", "pile", "lump", "lumps"  adjectives "small", "black" }
    passage short { pile of coal }
    describe { text "A small pile of coal, black and dusty, left at the end of the mine by somebody who meant to come back for it. It was once worth carrying to a certain machine. The machine is in another adventure, and so is the reason." }
    passage no_take { You could take a lump of it, and you would be a person carrying a lump of coal, which is not what the old man asked for. }
    as target for search { do { say "Coal, and coal dust, and under it the floor of the mine." } }
  }
}

object drafty_room is MineRoom in underground_caverns_3 {
  grammar {
    name "Drafty Room"
    exit south "south" -> machine_room
    exit east "east" -> timber_room
    exit out "out" -> timber_room
  }
  :walls 2
  passage body { This is a small drafty room in which is the bottom of a long shaft. To the south is a passageway and to the east a very narrow passage. In the shaft can be seen a heavy iron chain, going up into the dark. }
  object shaft is Scenery {
    grammar { name "shaft"  nouns "chain", "hole"  adjectives "long", "iron", "heavy" }
    passage short { shaft }
    describe { text "A long shaft going up into the dark, with a heavy iron chain hanging in it from a basket somewhere above. It was a way of getting things down here once, and up; it is not a way of getting you anywhere." }
    as target for climb_up { do { say "The chain is greasy and the shaft is long, and you are not a basket." } }
    passage no_take { The chain goes up further than you could pull. }
  }
}

object machine_room is MineRoom in underground_caverns_3 {
  grammar {
    name "Machine Room"
    exit north "north" -> drafty_room
  }
  :walls 2
  passage body { This is a large, cold room whose sole exit is to the north. In one corner there is a machine which is reminiscent of a clothes dryer. On its face is a switch which is labelled in a dialect of Elvish, and a lid, which is closed. }
  object machine is Scenery {
    grammar { name "machine"  nouns "dryer", "switch", "lid"  adjectives "strange", "large", "elvish" }
    passage short { machine }
    describe { text "A machine reminiscent of a clothes dryer, with a lid and a switch labelled in Elvish. You know what it does; you did it once, with a lump of coal and a screwdriver, in another adventure. There is no screwdriver here and no time, and the table will have you back before you could find either." }
    passage no_take { It is bolted to the floor, and heavier than the Empire's conscience. }
  }
}

// Zork II: Room 8, and the grue repellent.
object room_8 is MineRoom in underground_caverns_3 {
  grammar {
    name "Room 8"
    exit east "east" refuse "You are repelled from the exit by a fierce wind."
  }
  :walls 2
  :seeded false
  passage body { This is a small chamber carved out of the rock at the end of a short crawl. On the wall is crudely chiseled the number "8". The only apparent exit, to the east, seems to be a blur and a loud, whirring sound resounds through the rock. }
  on :entered (item, from) {
    if (item.is(Adventurer) && !self.get(:seeded)) {
      self.set(:seeded, true)
      spawn Repellent in self
    }
  }
  object number is Scenery, Readable {
    grammar { name "number"  nouns "eight", "numeral", "chisel-marks"  adjectives "crude", "chiseled" }
    passage short { number }
    describe { text "The number \"8\", chiseled crudely into the wall by somebody who was not a stonemason and was in a hurry. You have seen it before. It was the eighth of a set, and the set was a game within a game." }
    as target for read { do { say "\"8\"." } }
  }
  object blur is Scenery {
    grammar { name "blur"  nouns "exit", "whirring", "wind", "sound", "crawl"  adjectives "loud", "fierce", "whirring", "short" }
    passage short { blur }
    describe { text "The exit to the east is a blur, as though something were moving across it too fast to see, and the whirring that fills the rock comes from it. Going that way is a thing the wind has opinions about." }
    as target for listen { do { say "A loud, whirring sound, steady and fast, like the Empire's own machinery still turning somewhere." } }
    as target for through { do { say "You are repelled from the exit by a fierce wind." } }
  }
}

// Zork IV: the Sacrificial Altar, and what is done on it.
object altar_room is Altar in underground_caverns_3 {
  grammar { name "Sacrificial Altar" }
  :walls 16
  passage body { This is the interior of a huge temple of primitive construction. A few flickering torches cast a sallow illumination over the altar, which is still drenched with the blood of human sacrifice. }
  passage sacrifice { This is the interior of a huge temple of primitive construction. A few flickering torches cast a sallow illumination over the altar, which is still drenched with the blood of human sacrifice. Behind the altar is an enormous statue of a demon which seems to reach towards you with dripping fangs and razor-sharp talons. A low noise begins behind you, and you turn to see hundreds of hunched and hairy shapes. A guttural chant issues from their throats. Near you stands a figure draped in a robe of deepest black, brandishing a huge sword. The chant grows louder as the robed figure approaches the altar. The large figure spots you and approaches menacingly. It reaches into its cloak and pulls out a great, glowing dagger. It pulls you onto the altar and, with a murmur of approval from the throng, slices you neatly across your abdomen. }
  // Entered, it is a death (ZORK-IV-F): the altar tells it, since whoever
  // arrives is carried on in the same turn and never reads the room.
  on :entered (item, from) {
    if (item.is(Adventurer)) {
      tell item "Sacrificial Altar"
      tell item sacrifice
      send item :altar_death
    }
  }
  object altar is Scenery {
    grammar { name "altar"  nouns "covers", "blood"  adjectives "sacrificial", "wet", "velvet" }
    passage short { altar }
    describe { text "An altar, wet." }
  }
}
