{
  "about": "The earthquake (I-CLEFT), once, between the 70th and the 140th move: felt at the Aqueduct View as the pillar's fall, and the aqueduct's arch broken after it.",
  "steps": [
    { "arrive": "Ann", "expect": [
      { "reader": "Ann", "kind": "described", "words": "As in a dream, you see yourself tumbling down a great, dark staircase. All about you are shadowy images of struggles against fierce opponents and diabolical traps. These give way to another round of images: of imposing stone figures, a cool, clear lake, and, now, of an old, yet oddly youthful man. He turns toward you slowly, his long, silver hair dancing about him in a fresh breeze. \"You have reached the final test, my friend! You are proved clever and powerful, but this is not yet enough! Seek me when you feel yourself worthy!\" The dream dissolves around you as his last words echo through the void...." },
      { "reader": "Ann", "kind": "described", "words": "Endless Stair" },
      { "reader": "Ann", "kind": "described", "words": "You are at the bottom of a seemingly endless stair, winding its way upward beyond your vision. An eerie light, coming from all around you, casts strange shadows on the walls. To the south is a dark and winding trail." },
      { "reader": "Ann", "kind": "described", "words": "Your old friend, the brass lantern, is at your feet." }
    ] },
    { "seed": 2 },
    { "as": "Ann", "type": "take lamp", "expect": [
      { "reader": "Ann", "kind": "said", "words": "Taken." }
    ] },
    { "as": "Ann", "type": "turn on lamp", "expect": [
      { "reader": "Ann", "kind": "said", "words": "The lamp is now on." }
    ] },
    { "as": "Ann", "type": "s", "expect": [
      { "reader": "Ann", "kind": "described", "words": "Junction" },
      { "reader": "Ann", "kind": "described", "words": "You are at the junction of a north-south passage and an east-west passage. To the north, you can make out the bottom of a stairway. The ways to the east and south are relatively cramped, but a wider trail leads to the west." },
      { "reader": "Ann", "kind": "described", "words": "Standing before you is a great rock. Imbedded within it is an Elvish sword." }
    ] },
    { "as": "Ann", "type": "s", "expect": [
      { "reader": "Ann", "kind": "described", "words": "Creepy Crawl" },
      { "reader": "Ann", "kind": "described", "words": "You are in a dark and quite creepy crawlway with passages leaving to the north, east, south, and southwest." }
    ] },
    { "as": "Ann", "type": "s", "expect": [
      { "reader": "Ann", "kind": "described", "words": "Foggy Room" },
      { "reader": "Ann", "kind": "described", "words": "You are in a dank passage filled with a wispy fog. A spooky passageway leads north and a wider path heads off to the south. To the west, the path leaves the rock and enters an eerie, shadowy land." }
    ] },
    { "as": "Ann", "type": "s", "expect": [
      { "reader": "Ann", "kind": "described", "words": "Lake Shore" },
      { "reader": "Ann", "kind": "described", "words": "You are in a wide cavern on the north shore of a small lake. Some polished stone steps lead to the southeast and a sheer rock face prevents any movement around the lake to the southwest. The cavern is dimly lit from above. The water has the look of a cold that would open your hands for you, and would not give back what fell out of them; everything in your hands goes to the bottom, not the light and the sword only but every last thing you carry, and whatever you cannot afford to lose there had better be left on the shore, which is lit, after its fashion, and will keep it. What you wear, it leaves you." },
      { "reader": "Ann", "kind": "told", "words": "The light you carry throws your shadow on the water, which does not want it: a lamp goes under here, lit or dark, and comes up a dead one, and the shore is where it should be left, with everything else in your hands." }
    ] },
    { "as": "Ann", "type": "se", "expect": [
      { "reader": "Ann", "kind": "described", "words": "Aqueduct View" },
      { "reader": "Ann", "kind": "described", "words": "This is a small balcony carved into a near-vertical cliff. To the east, stretching from north to south, stands a monumental aqueduct supported by mighty stone pillars, some of which are starting to crumble from age. You feel a sense of loss and sadness as you ponder this once-proud structure and the failure of the Empire which created this and other engineering marvels. Some stone steps lead up to the northwest." }
    ] },
    { "as": "Ann", "type": "wait", "expect": [
      { "reader": "Ann", "kind": "said", "words": "Time passes..." }
    ] },
