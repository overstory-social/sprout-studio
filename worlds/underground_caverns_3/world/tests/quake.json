      { "reader": "Ann", "kind": "told", "words": "There is a great tremor from within the earth. The entire dungeon shakes violently and loose debris falls from above you." },
      { "reader": "Ann", "kind": "told", "words": "One of the giant pillars supporting the aqueduct collapses in a pile of smoke and rubble!" }
    ] },
    { "as": "Ann", "type": "wait", "expect": [
