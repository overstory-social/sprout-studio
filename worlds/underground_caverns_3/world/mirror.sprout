    exit northwest "northwest" -> mraw when (underground_caverns_3.get(:mdir) == 0 || underground_caverns_3.get(:mdir) == 180)
    exit northwest "northwest" refuse broken_block when ((underground_caverns_3.get(:mdir) == 270 && !underground_caverns_3.get(:mr1)) || (underground_caverns_3.get(:mdir) == 90 && !underground_caverns_3.get(:mr2)))
    exit northwest "northwest" refuse mirror_block
    exit south "south" -> button_room
  }
  :id beam_room
  :k 0
  :kn 1
  :ks 0
  :walls 26
  passage structure_blocks { The structure blocks your way. }
  passage local { You are in the middle of a long north-south corridor whose walls are polished stone. A narrow red beam of light crosses the room at the north end, inches above the floor.{if self.get(:blocked)} The beam is blocked by {for t: Portable in self}{if !$first}, {if $last}and {/if}{/if}{t.a_short}{/for} lying on the floor.{/if} }
  object beam is Beam
}

