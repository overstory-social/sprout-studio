// The Guardians' own stretch (MRG): entered on foot, it is a death, unless
// the one entering cannot be seen. The box is the other way past them.
kind GuardianRoom is Hallway {
  on :entered (item, from) {
    if (item.is(Adventurer)) {
      send underground_caverns_3 :guardians_seen
      if (!item.get(:invisible)) {
        tell item "The Guardians awake, and in perfect unison, pulverize you with their bludgeons. Satisfied, they resume their posts."
        send item :die
      }
    }
  }
}
kind GuardianSide is NarrowRoom {
  on :entered (item, from) {
    if (item.is(Adventurer)) {
      send underground_caverns_3 :guardians_seen
      if (!item.get(:invisible)) {
        tell item "The Guardians awake, and in perfect unison, pulverize you with their bludgeons. Satisfied, they resume their posts."
        send item :die
      }
    }
  }
}

