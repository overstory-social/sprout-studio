// Beyond the secret door (MR-ANTE, MREYE, MRA to MRD, the ten narrow rooms,
// IN-MIRROR; MRGO, MIRIN, MIROUT, MIRNS, MIREW, LOOK-TO, EWTELL, GUARDIANS,
// MIRROR-FUNCTION, PANEL-FUNCTION, BEAM-FUNCTION, MRSWITCH, I-MRINT,
// MAGIC-MIRROR, MPANELS, MENDS, I-PININ, MIRMOVE, SHORT-POLE-F): the
// Button Room and its red button, the Beam Room and its beam, the long
// hallway with the Guardians of Zork in the middle of it, and the mirror
// box, a room you are inside that moves: turned an eighth at a time on
// its pole and slid along the channel from one compass rose to the next,
// past the Guardians, who strike what they see.
//
// The box is one box for everyone, so where it stands (MLOC, 1 to 5 for
// the hallways MRA to MRD), which way its arrow points (MDIR, in eighths
// of a turn from north), its pole, its two mirrors, its two doors and
// their clocks are the world's. The hallway is five places and the box's
// sides are ten more: a narrow room is the strip of hallway beside the
// box when the box stands long-ways, and leads nowhere when it does not.
// Every way into or out of the box depends on where it stands and which
// way it faces, so each is a run of conditional exits, and leaving the box
// goes by way of a landing that the one leaving is carried on from, since
// an exit's destination is written in source and the box's are not.
import * as sprout from 'sprout'
import {Thing, Scenery, Portable, Fixed, Creature, Touchable, Openable, Receptacle, Trace, Concealing, Placeable} from 'thing'
import {Room, Floor, Ceiling} from 'room'
import {Adventurer} from 'adventurer'
import {Stairs} from 'way_in'
import {engravings_room} from 'engravings'
import {front_door} from 'dungeon'
import {examine} from 'sprout'
import {open, close, look_in, shift, raise, lower, turn, mung, through, talk, greet, hail, put, rub, listen, follow_sound, leap_at, take_fixed, Panel, Dest, :die, :beam_set, :mirror_set, :mirror_shut, :wood_set, :wood_shut, :mdir_set, :mloc_set, :pole_set, :mirror_broken, :guardians_seen, :mirror_out} from 'verbs'

// Which side of the box a narrow room lies on.
enum Side { east, west }

// A mirror or a panel told which side of the box it is, 1 the side the
// button opens, 2 the other, 0 neither, by its room as a visitor comes in,
// since which side faces a room changes only while the box is turned from
// inside, and a thing that is not an actor has no `here` of its own.
message :set_side with integer

// A stretch of the long hallway (MRA to MRD, MREYE and FRONT-DOOR at its
// ends): `:k` is its place in the line, 0 the Beam Room, 1 to 5 the
// hallways, 6 the Dungeon Entrance; `:kn` and `:ks` the stretches north
// and south of it.
kind Hallway is Room {
  :k 0 min 0 max 6
  :kn 0 min 0 max 6
  :ks 0 min 0 max 6
  :ntell false
  :stell false
  passage hall_para { This is a part of the long hallway. The east and west walls are dressed stone. In the center of the hall is a shallow stone channel. In the center of the room the channel widens into a large hole around which is engraved a compass rose. }
  passage local default { {if false}.{/if} }
  passage box_north {
    {if underground_caverns_3.get(:mloc) == self.get(:kn)}{if underground_caverns_3.get(:mdir) == 0 || underground_caverns_3.get(:mdir) == 180}The north side of the room is divided by a wooden wall into small hallways to the northeast and northwest.{if self.get(:kn) == 4} They run on north between the Guardians' pedestals, one on each side of the structure, in plain view of both statues.{/if}{else}{if underground_caverns_3.get(:mdir) > 180}{if underground_caverns_3.get(:mr1)}A large mirror fills the north side of the hallway.{else}A large panel fills the north side of the hallway.{/if}{if underground_caverns_3.get(:mirror_open)} {if underground_caverns_3.get(:mr1)}The mirror is mounted on a panel which has been opened outward.{else}The panel has been opened outward.{/if}{/if}{else}{if underground_caverns_3.get(:mr2)}A large mirror fills the north side of the hallway.{else}A large panel fills the north side of the hallway.{/if}{/if}{/if}{/if}
  }
  passage box_south {
    {if underground_caverns_3.get(:mloc) == self.get(:ks)}{if underground_caverns_3.get(:mdir) == 0 || underground_caverns_3.get(:mdir) == 180}The south side of the room is divided by a wooden wall into small hallways to the southeast and southwest.{if self.get(:ks) == 4} They run on south between the Guardians' pedestals, one on each side of the structure, in plain view of both statues.{/if}{else}{if underground_caverns_3.get(:mdir) < 180}{if underground_caverns_3.get(:mr1)}A large mirror fills the south side of the hallway.{else}A large panel fills the south side of the hallway.{/if}{if underground_caverns_3.get(:mirror_open)} {if underground_caverns_3.get(:mr1)}The mirror is mounted on a panel which has been opened outward.{else}The panel has been opened outward.{/if}{/if}{else}{if underground_caverns_3.get(:mr2)}A large mirror fills the south side of the hallway.{else}A large panel fills the south side of the hallway.{/if}{/if}{/if}{/if}
  }
  passage continues {
    {if !self.get(:ntell) && underground_caverns_3.get(:mloc) != self.get(:kn) && !self.get(:stell) && underground_caverns_3.get(:mloc) != self.get(:ks)}The corridor continues north and south.{else if !self.get(:ntell) && underground_caverns_3.get(:mloc) != self.get(:kn)}The corridor continues north.{else if !self.get(:stell) && underground_caverns_3.get(:mloc) != self.get(:ks)}The corridor continues south.{/if}
  }
  passage body {
    {if self.get(:k) >= 1 && self.get(:k) <= 5}{self.hall_para}{/if}

    {self.local}

    {self.box_north}{self.box_south}

    {self.continues}
  }
  passage wooden_wall { There is a wooden wall blocking your way. }
  passage mirror_block { There is a large mirror blocking your way. }
  passage broken_block { There is a large broken mirror blocking your way. }
  // The mirror's first side, the one the button opens, faces this stretch
  // when the box stands across the corridor next door with that side
  // toward it.
  :faced false
  on :mirror_shut {
    self.set(:faced, false)
    if (underground_caverns_3.get(:mloc) == self.get(:kn) && underground_caverns_3.get(:mdir) > 180) { self.set(:faced, true) }
    if (underground_caverns_3.get(:mloc) == self.get(:ks) && underground_caverns_3.get(:mdir) > 0 && underground_caverns_3.get(:mdir) < 180) { self.set(:faced, true) }
    if (self.get(:faced)) { tell "The mirror quietly swings shut." }
  }
  on :wood_shut {
    self.set(:faced, false)
    if (underground_caverns_3.get(:mloc) == self.get(:kn) && underground_caverns_3.get(:mdir) == 0) { self.set(:faced, true) }
    if (underground_caverns_3.get(:mloc) == self.get(:ks) && underground_caverns_3.get(:mdir) == 180) { self.set(:faced, true) }
    if (self.get(:faced)) { tell "Somewhere in the wooden structure a panel closes quietly." }
  }
  :side_now 0 min 0 max 2
  on :entered (item, from) {
    if (item.is(Adventurer)) {
      let md = underground_caverns_3.get(:mdir)
      let ml = underground_caverns_3.get(:mloc)
      self.set(:side_now, 0)
      if (md != 0 && md != 180) {
        if (ml == self.get(:kn)) { if (md > 180) { self.set(:side_now, 1) } else { self.set(:side_now, 2) } }
        else if (ml == self.get(:ks)) { if (md < 180) { self.set(:side_now, 1) } else { self.set(:side_now, 2) } }
      }
      each m: BoxMirror in self { send m :set_side with self.get(:side_now) }
      each p: BoxOuterPanel in self { send p :set_side with self.get(:side_now) }
    }
  }
}

// The strip of hallway beside the box (MRAE to MRDW; EWTELL): east or
// west of the box when it stands long-ways in the stretch `:k`.
kind NarrowRoom is Room {
  :k 1 min 1 max 5
  :side Side default east
  passage local default { {if false}.{/if} }
  passage body {
    You are in a narrow room, whose {if self.get(:side) == :east}west{else}east{/if} wall is a large {if self.get(:side) == :east}{if underground_caverns_3.get(:mdir) == 180}{if underground_caverns_3.get(:mr1)}mirror.{else}wooden panel which once contained a mirror.{/if}{if underground_caverns_3.get(:mirror_open)} {if underground_caverns_3.get(:mr1)}The mirror is mounted on a panel which has been opened outward.{else}The panel has been opened outward.{/if}{/if}{else}{if underground_caverns_3.get(:mr2)}mirror.{else}wooden panel which once contained a mirror.{/if}{/if}{else}{if underground_caverns_3.get(:mdir) == 0}{if underground_caverns_3.get(:mr1)}mirror.{else}wooden panel which once contained a mirror.{/if}{if underground_caverns_3.get(:mirror_open)} {if underground_caverns_3.get(:mr1)}The mirror is mounted on a panel which has been opened outward.{else}The panel has been opened outward.{/if}{/if}{else}{if underground_caverns_3.get(:mr2)}mirror.{else}wooden panel which once contained a mirror.{/if}{/if}{/if} The opposite wall is solid rock.

    {self.local}
  }
  passage mirror_blocks { A mirror blocks your way. }
  passage panel_closed { The panel is closed. }
  passage structure_blocks { The structure blocks your way. }
  :faced false
  on :mirror_shut {
    self.set(:faced, false)
    if (self.get(:side) == :east && underground_caverns_3.get(:mdir) == 180) { self.set(:faced, true) }
    if (self.get(:side) == :west && underground_caverns_3.get(:mdir) == 0) { self.set(:faced, true) }
    if (self.get(:faced)) { tell "The mirror quietly swings shut." }
  }
  :side_now 0 min 0 max 2
  on :entered (item, from) {
    if (item.is(Adventurer)) {
      let md = underground_caverns_3.get(:mdir)
      self.set(:side_now, 2)
      if (self.get(:side) == :east && md == 180) { self.set(:side_now, 1) }
      if (self.get(:side) == :west && md == 0) { self.set(:side_now, 1) }
      each m: BoxMirror in self { send m :set_side with self.get(:side_now) }
      each p: BoxOuterPanel in self { send p :set_side with self.get(:side_now) }
    }
  }
}

// The Guardians of Zork (GUARDIAN, GUARDIANS): two stone statues facing
// each other across the hallway, who strike what they see between them,
// in perfect unison, and cannot tell a reflection from each other. A
// thing of every room they can be seen from, and of the box, from which
// they cannot.
kind Guardians is Scenery, Creature {
  contains
  pass any (false)
  grammar { name "Guardians of Zork"  nouns "guardians", "guardian", "statues", "statue", "guards", "guard", "warriors", "bludgeons"  adjectives "stone", "identical", "impassive", "heavily", "armored" }
  passage short { Guardians of Zork }
  passage indef { The Guardians of Zork }
  passage a_short { the Guardians of Zork }
  describe {
    if (here.is(MirrorBox)) { text "You can't see them from here." }
    else { text looked_at }
  }
  passage looked_at { The Guardians are quite impressive. I wouldn't get in their way if I were you! They are portrayed as heavily armored warriors clasping formidable bludgeons, and they stand with the stillness of things that have never yet had to move twice; the bludgeons are raised a little, as if the sculptor had been asked to show them in the moment before, and had. Their eyes are open, and the eyes are the point of them: they strike, it is said, at whatever they see pass between them, and at nothing they do not see; and nobody has yet reported what they do about a visitor they cannot see, there having been, so far, no such visitor. }
  passage no_take { They are stone, and larger than you, and they would take it as an approach. }
  as target for talk { do { say "The statues are impassive." } }
  as target for greet { do { say "The statues are impassive." } }
  as target for hail { do { say "The statues are impassive." } }
  as target for listen { do { say "Stone makes no sound, and these make less than most; and yet you have the feeling of being listened to." } }
  as target for rub { do { say "You are not close enough to touch them, and you find that you do not mind." } }
}

// The compass rose (ROSE, ROSE-F), cut in the stone round the hole in the
// channel, in every hallway and under the box.
kind Rose is Scenery {
  grammar { name "compass rose"  nouns "rose", "hole", "depression"  adjectives "compass", "engraved", "incised", "circular" }
  passage short { compass rose }
  describe { text "A compass rose, cut into the stone floor round a circular hole where the channel widens: the eight points of the compass, north at the top, incised deep and clean by somebody who meant them to be read by a thing rather than a person. The hole in the middle is the size of a pole's end." }
  as target for turn { do { say "The compass rose is made of stone and is imbedded in the ground. You could not possibly turn it or move it." } }
  as target for shift { do { say "The compass rose is made of stone and is imbedded in the ground. You could not possibly turn it or move it." } }
  passage no_take { It is cut into the floor. }
}

// The stone channel (CHANNEL) down the middle of the hallway, that the box
// slides along, and that the short pole may be dropped into.
kind Channel is Scenery, Receptacle {
  grammar { name "stone channel"  nouns "channel", "groove", "track"  adjectives "stone", "shallow", "narrow" }
  passage short { stone channel }
  describe { text "A shallow channel cut in the stone floor, about six inches wide and a foot deep, running north and south down the middle of the hallway and widening, at each compass rose, into a round hole. Something was meant to run along it, and from the wear on its edges, something has." }
  as container for put { do { } }
  passage no_take { It is a groove in the floor, and the floor is staying. }
}

// The wooden wall of the box, seen from a hallway the box stands long-ways
// beside (WOODEN-WALL, WOODEN-WALL-F).
kind WoodenWall is Scenery, Openable {
  grammar { name "wooden wall"  nouns "structure", "box"  adjectives "wooden", "wood", "large" }
  passage short { wooden wall }
  :seen_here false
  passage no_door { There is no door in this end of it, and no way in from here: the structure is entered by the mirror on its long side, which the red button in the room at the foot of the stairs opens, and from nowhere else. }
  describe {
    if (here.is(Hallway)) {
      if ((underground_caverns_3.get(:mdir) == 0 || underground_caverns_3.get(:mdir) == 180) && (underground_caverns_3.get(:mloc) == here.get(:kn) || underground_caverns_3.get(:mloc) == here.get(:ks))) {
        text "The end of a large wooden structure, standing in the hallway with its long sides toward the walls, so that there is room to pass on either side of it and none to pass through. The wood is carved and polished, and the end facing you is a panel of a single plank, with no handle and no hinge that you can find. {self.no_door}"
      }
      else { text "You can't see any wooden wall here." }
    }
    else { text "You can't see any wooden wall here." }
  }
  as target for through {
    do {
      self.set(:seen_here, false)
      if (here.is(Hallway)) {
        if ((underground_caverns_3.get(:mdir) == 0 || underground_caverns_3.get(:mdir) == 180) && (underground_caverns_3.get(:mloc) == here.get(:kn) || underground_caverns_3.get(:mloc) == here.get(:ks))) { self.set(:seen_here, true) }
      }
      if (self.get(:seen_here)) { say "You hit your head against the wooden wall as you attempt this feat. {self.no_door}" } else { say "You can't see any wooden wall here." }
    }
  }
  as target for open {
    do {
      self.set(:seen_here, false)
      if (here.is(Hallway)) {
        if ((underground_caverns_3.get(:mdir) == 0 || underground_caverns_3.get(:mdir) == 180) && (underground_caverns_3.get(:mloc) == here.get(:kn) || underground_caverns_3.get(:mloc) == here.get(:ks))) { self.set(:seen_here, true) }
      }
      if (self.get(:seen_here)) { say "You can't open the wooden wall. {self.no_door}" } else { say "You can't see any wooden wall here." }
    }
  }
  as target for close { do { say "It is as closed as a wall can be." } }
  as target for shift {
    do {
      self.set(:seen_here, false)
      if (here.is(Hallway)) {
        if ((underground_caverns_3.get(:mdir) == 0 || underground_caverns_3.get(:mdir) == 180) && (underground_caverns_3.get(:mloc) == here.get(:kn) || underground_caverns_3.get(:mloc) == here.get(:ks))) { self.set(:seen_here, true) }
      }
      if (self.get(:seen_here)) { say "The structure won't budge." } else { say "You can't see any wooden wall here." }
    }
  }
  passage no_take { It is a wall, of a structure a good deal heavier than you. }
}

// A mirror of the box, seen from outside (MIRROR, MIRROR-FUNCTION): the
// first, which the button opens, or the second; which one faces a room is
// worked out as a visitor comes in (`:refresh`), since it changes only
// while the box is turned from inside.
kind BoxFace is Scenery, Touchable {
  :m 0 min 0 max 2
  on :set_side (from, value) { self.set(:m, value) }
}
kind BoxMirror is BoxFace {
  grammar { name "mirror"  nouns "structure", "glass", "reflection"  adjectives "large", "huge", "tall" }
  passage short { mirror }
  describe {
    if (self.get(:m) == 0) { text "You can't see any mirror here." }
    else if ((self.get(:m) == 1 && !underground_caverns_3.get(:mr1)) || (self.get(:m) == 2 && !underground_caverns_3.get(:mr2))) { text "Where the mirror was is a wooden panel, plain and close-grained, the glass gone from it as though it had never been; a few specks along the frame catch the light and go out." }
    else { text "A large mirror, taller than you and nearly as wide as the hallway, mounted on a wooden panel which is the side of a wooden structure. It is a very good mirror. The hallway in it goes on as far as the hallway does, and the person in it is looking at you with an expression you recognise." }
  }
  as target for look_in {
    do {
      if (self.get(:m) == 0) { say "You can't see any mirror here." }
      else if ((self.get(:m) == 1 && underground_caverns_3.get(:mr1)) || (self.get(:m) == 2 && underground_caverns_3.get(:mr2))) {
        if (actor.is(Adventurer)) {
          if (actor.get(:invisible)) { say "Amazingly, you have no reflection!" } else { say "A disheveled adventurer stares back at you." }
        } else { say "A disheveled adventurer stares back at you." }
      }
      else { say "You have destroyed the mirror, or have you forgotten?" }
    }
  }
  as target for mung {
    do {
      if (self.get(:m) == 0) { say "You can't see any mirror here." }
      else if (self.get(:m) == 1) {
        if (underground_caverns_3.get(:mr1)) {
          send underground_caverns_3 :mirror_broken with 1
          say "The mirror breaks, revealing a wooden panel behind it. The glistening fragments of mirror quietly sparkle into nonexistance."
        } else { say "The mirror has already been broken." }
      }
      else if (underground_caverns_3.get(:mr2)) {
        send underground_caverns_3 :mirror_broken with 2
        say "The mirror breaks, revealing a wooden panel behind it. The glistening fragments of mirror quietly sparkle into nonexistance."
      }
      else { say "The mirror has already been broken." }
    }
  }
  as target for shift {
    do {
      if (self.get(:m) == 0) { say "You can't see any mirror here." }
      else if ((self.get(:m) == 1 && !underground_caverns_3.get(:mr1)) || (self.get(:m) == 2 && !underground_caverns_3.get(:mr2))) { say "There's no mirror left." }
      else if (self.get(:m) == 1) { say "The mirror is mounted on a wooden panel which moves slightly inward as you push, and back out when you let go. It feels fragile." }
      else { say "The mirror is unyielding, but seems fragile." }
    }
  }
  as target for open {
    do {
      if (self.get(:m) == 0) { say "You can't see any mirror here." }
      else { say "You don't see a way to open the mirror here." }
    }
  }
  as target for rub {
    do {
      if (self.get(:m) == 0) { say "You can't see any mirror here." }
      else if ((self.get(:m) == 1 && !underground_caverns_3.get(:mr1)) || (self.get(:m) == 2 && !underground_caverns_3.get(:mr2))) { say "Wood, where there was glass; smooth, and a little warm." }
      else { say "Cold glass, and a hand coming to meet yours from the other side of it, which stops exactly where yours does." }
    }
  }
  // Going in by the mirror is going in: the one going does it
  // (adventurer.sprout).
  as target for through { do { } }
  passage no_take { It is mounted on the side of a structure that is heavier than the Empire's debts. }
}

// The panel a mirror is mounted on, seen from outside (PANEL,
// PANEL-FUNCTION).
kind BoxOuterPanel is BoxFace, Openable {
  grammar { name "wooden panel"  nouns "panel"  adjectives "wooden", "wood" }
  passage short { wooden panel }
  describe {
    if (self.get(:m) == 0) { text "You can't see any panel here." }
    else if (self.get(:m) == 1 && underground_caverns_3.get(:mirror_open)) { text "A wooden panel, one long side of a wooden structure, with a mirror mounted on it; it has been opened outward on a hinge you could not see when it was shut, and behind it is the inside of the structure, and a way in." }
    else { text "A wooden panel, carved and polished, one long side of a wooden structure that stands in the hallway{if (self.get(:m) == 1 && underground_caverns_3.get(:mr1)) || (self.get(:m) == 2 && underground_caverns_3.get(:mr2))}, with a large mirror mounted on it{/if}. It gives a little when leaned on, the way a door does." }
  }
  as target for open {
    do {
      if (self.get(:m) == 0) { say "You can't see any panel here." }
      else { say "You don't see a way to open the panel here." }
    }
  }
  as target for close { do { say "You can't do that to the panel." } }
  as target for mung {
    do {
      if (self.get(:m) == 0) { say "You can't see any panel here." }
      else if ((self.get(:m) == 1 && underground_caverns_3.get(:mr1)) || (self.get(:m) == 2 && underground_caverns_3.get(:mr2))) { say "To break the panel you would have to break the mirror first." }
      else { say "The panel is not that easily destroyed." }
    }
  }
  as target for shift {
    do {
      if (self.get(:m) == 0) { say "You can't see any panel here." }
      else if (self.get(:m) == 1) { say "The wooden panel moves slightly inward as you push, and back out when you let go." }
      else { say "The panel is unyielding." }
    }
  }
  as target for through { do { } }
  passage no_take { It is the side of a structure, and stays with it. }
}

// The Button Room (MR-ANTE): the foot of the stairs down from the secret
// door, and the red button on its wall.
object button_room is Room in underground_caverns_3 {
  grammar {
    name "Button Room"
    exit south "south" -> engravings_room
    exit up "up" -> engravings_room
    exit north "north" -> beam_room
  }
  :id button_room
  :walls 26
  passage body { You are at the southern end of a long hall. To the south, stairs ascend into darkness. To the north the corridor is illuminated by torches set high in the walls, out of reach. On one wall is a red button. }
  object button is Scenery, Touchable {
    grammar { name "red button"  nouns "button", "switch"  adjectives "red", "large", "round" }
    passage short { red button }
    describe { text "A red button, set in the wall at the height of a hand, with nothing written near it to say what it does. It has been pushed before; the red is worn through to brass at the middle." }
    // MRSWITCH: with the beam broken, the button opens the mirror's first
    // side for seven moves; otherwise it clicks.
    as target for shift {
      do {
        if (underground_caverns_3.get(:mirror_open)) { say "Click." }
        else if (underground_caverns_3.get(:beam_blocked)) {
          say "Click. Snap!"
          send underground_caverns_3 :mirror_set with true
        }
        else { say "Click." }
      }
    }
    as target for rub { do { say "It is a button; it would rather be pushed than felt." } }
    passage no_take { It is set in the wall. }
  }
  object torches is Scenery {
    grammar { name "torches"  nouns "torch", "flame", "flames", "light"  adjectives "high", "flickering", "wall" }
    passage short { torches }
    describe { text "Torches, set in brackets high in the walls to the north, well out of reach, and burning with a steadiness that torches do not usually manage; whoever lit them did not expect to have to come back and do it again." }
    passage no_take { The torches are out of reach. }
    as target for rub { do { say "The torches are out of reach." } }
  }
  object stairs is Stairs {
    grammar { nouns "staircase", "steps" }
    describe { text "The stairs go up to the south, into the dark, to the secret door and the Engravings Room beyond it. They are the stairs you came down." }
  }
  on :mirror_shut { tell "The button pops back to its original position." }
}

// The Beam Room (MREYE, MREYE-ROOM, BEAM, BEAM-FUNCTION): a red beam of
// light across its north end, an inch above the floor, which a thing laid
// on the floor breaks.
kind BeamRoom is Hallway {
  :blocked false
  on :entered (item, from) {
    if (item.is(Portable)) {
      self.set(:blocked, true)
      send underground_caverns_3 :beam_set with true
    }
  }
  on :left (item, to) {
    if (item.is(Portable)) {
      self.set(:blocked, false)
      each t: Portable in self { self.set(:blocked, true) }
      send underground_caverns_3 :beam_set with self.get(:blocked)
    }
  }
}
kind Beam is Scenery, Receptacle, Trace {
  grammar { name "red beam of light"  nouns "beam", "light", "ray"  adjectives "red", "narrow", "thin" }
  passage short { red beam of light }
  describe { text "The red beam of light crosses the north end of the room only an inch or so above the floor.{if here.is(BeamRoom)}{if here.get(:blocked)} The beam is broken by {for t: Portable in here}{if !$first}, {if $last}and {/if}{/if}{t.a_short}{/for} lying on the ground.{/if}{/if}" }
  as container for put { do { } }
  as target for follow_sound { do { say "It simply crosses the northern end of the room, so there's nowhere to follow it." } }
  as target for mung { do { if (!bound tool) { say "You pass your hand through the beam, and the beam is broken briefly as it passes through, and whole again behind it." } } }
  as target for rub { do { say "The beam is broken briefly as your hand passes through." } }
  as target for leap_at { do { } }
  passage no_take { No doubt you have a bottle of moonbeams as well. }
}

object beam_room is BeamRoom in underground_caverns_3 {
  grammar {
    name "Beam Room"
    exit north "north" -> mra when (underground_caverns_3.get(:mloc) != 1)
    exit north "north" refuse wooden_wall when (underground_caverns_3.get(:mdir) == 0 || underground_caverns_3.get(:mdir) == 180)
    exit north "north" -> in_mirror when (underground_caverns_3.get(:mirror_open) && underground_caverns_3.get(:mdir) > 180)
    exit north "north" refuse broken_block when ((underground_caverns_3.get(:mdir) == 270 && !underground_caverns_3.get(:mr1)) || (underground_caverns_3.get(:mdir) == 90 && !underground_caverns_3.get(:mr2)))
    exit north "north" refuse mirror_block
    exit in "in" -> in_mirror when (underground_caverns_3.get(:mloc) == 1 && underground_caverns_3.get(:mirror_open) && underground_caverns_3.get(:mdir) > 180)
    exit in "in" refuse structure_blocks
    exit northeast "northeast" -> mra when (underground_caverns_3.get(:mloc) != 1)
    exit northeast "northeast" -> mrae when (underground_caverns_3.get(:mdir) == 0 || underground_caverns_3.get(:mdir) == 180)
    exit northeast "northeast" refuse broken_block when ((underground_caverns_3.get(:mdir) == 270 && !underground_caverns_3.get(:mr1)) || (underground_caverns_3.get(:mdir) == 90 && !underground_caverns_3.get(:mr2)))
    exit northeast "northeast" refuse mirror_block
