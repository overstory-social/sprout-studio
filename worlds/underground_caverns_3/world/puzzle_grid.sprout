// The thirty-six squares of the Royal Puzzle (CP, CPTABLE), generated
// from the original's table of walls: 0 open floor, 1 marble, -1
// sandstone, -2 the sandstone with the good ladder, -3 the one with the
// bad. Each square keeps a copy of the twelve cells round it and reads
// them again from the world whenever a wall is pushed (:cp_changed); its
// ways out are decided by those copies, so a square whose neighbour is a
// wall offers no way there, and a diagonal step needs an open square on
// one side of the corner (CPEXIT). Cell 1 is under the round hole, cell
// 22 holds the book's niche, and cell 33 the steel door and the slot.
import * as sprout from 'sprout'
import {PuzzleSquare, cp_ante, cp_out} from 'puzzle'
import {:cp_changed} from 'verbs'


object cp_1 is PuzzleSquare in underground_caverns_3 {
  :idx 1
  :col 1
  :row 1
  :vn 1
  :vs -1
  :ve -1
  :vw 1
  :vne 1
  :vnw 1
  :vse 0
  :vsw 1
  :vn2 1
  :vs2 0
  :ve2 0
  :vw2 1
  grammar {
    exit north "north" refuse "There is a wall there."
    exit south "south" -> cp_7 when (self.get(:vs) == 0)
    exit south "south" refuse "There is a wall there."
    exit east "east" -> cp_2 when (self.get(:ve) == 0)
    exit east "east" refuse "There is a wall there."
    exit west "west" refuse "There is a wall there."
    exit northeast "northeast" refuse "There is a wall there."
    exit northwest "northwest" refuse "There is a wall there."
    exit southeast "southeast" -> cp_8 when (self.get(:vse) == 0 && (self.get(:vs) == 0 || self.get(:ve) == 0))
    exit southeast "southeast" refuse "There is a wall there."
    exit southwest "southwest" refuse "There is a wall there."
    exit up "up" -> cp_ante say "With the help of the ladder, you exit the puzzle." when (self.get(:ve) == -2)
    exit up "up" refuse "The exit is too far above your head."
    exit down "down" refuse "There's no way down here."
  }
  on :cp_changed {
    self.set(:vs, underground_caverns_3.get(:c7))
    self.set(:ve, underground_caverns_3.get(:c2))
    self.set(:vse, underground_caverns_3.get(:c8))
    self.set(:vs2, underground_caverns_3.get(:c13))
    self.set(:ve2, underground_caverns_3.get(:c3))
  }
}

